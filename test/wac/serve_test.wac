// A page drawn into another page's element: a child's `wac.page` answered by a `PageServer`, with no process
// between them — the child's host hands each request straight to the server, as a desktop's channel would carry it.
//
// The desktop's page is a `TestDoc`, so what the child drew can be read off its records and events fired at it; the
// child holds its changes and sends them together, as a child of a real host does.

import { Check } from "./check.wac";
import { Result, Ticket, Vec } from "core";
import { Answer, HOST_CANNOT_WAIT, Host, OP_CAPABILITY, OP_MONOTONIC_NANOS, Sys, answered } from "std";
import { DESKTOP_CAPABILITY, DESKTOP_COUNT, DESKTOP_NEW, DESKTOP_OPEN, DESKTOP_PICK, DESKTOP_WINDOW, PAGE_BATCH, PAGE_EVENT, PAGE_LOCATION, Desktop, Element, ElementEvent, Node, PAGE_COUNT, Picked, Runner, PAGE_MAKE, PAGE_ATTR, PAGE_REMOVE, PAGE_VERSION, Page, PageLine,
         PageServer, TestDoc, Ui, html.b, html.button, html.p, pair, when } from "../../src/page.wac";

/** Where the child's host numbers `wac.page`, and `wac.desktop`. */
static i32 BASE = 8192;
static i32 DESK = 9000;

/** The desktop's document and page, the window the child draws in, the server, and the child's page. */
struct Rig {
  TestDoc doc;
  Page desk;
  Element window;
  PageServer server;
  Page child;
  string title;
  ChildHost? host;
}

/** A child whose requests are answered by `server`: inside the request when the answer is ready, later otherwise. */
struct ChildHost {
  PageServer server;
  Host? host;
  Page? page;
  i32 asking;
  /** What the desktop's picker answers, in turn: a path, or `""` for nothing chosen. */
  Vec<string> picks;
  /** Each request for a window's slice of `wac.page` other than the first, as `slice:offset`. */
  string otherSlices;

  void request(this, i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) {
    if (op == OP_CAPABILITY() && text == DESKTOP_CAPABILITY()) {
      this.give(id, Answer(0, "1.0.0", u8[](), DESK as i64, DESKTOP_COUNT as i64, 0));
      return;
    }
    if (op == DESK + DESKTOP_WINDOW) {
      this.give(id, Answer(0, "", u8[](), 2 as i64, 0 as i64, 0));
      return;
    }
    if (op >= BASE + PAGE_COUNT && op < BASE + PAGE_COUNT * 4) {
      i32 k = op - BASE;
      this.otherSlices = this.otherSlices + "\{k / PAGE_COUNT}:\{k % PAGE_COUNT};";
      // A batch is answered at once; the requests a page keeps open — its next event, its location — wait.
      if (k % PAGE_COUNT == PAGE_BATCH) { this.give(id, Answer(0, "", u8[](), 0 as i64, 0 as i64, 0)); }
      return;
    }
    if (op == DESK + DESKTOP_OPEN) {
      this.otherSlices = this.otherSlices + "open \{a}:\{text};";
      this.give(id, Answer(0, "", u8[](), 0 as i64, 0 as i64, 0));
      return;
    }
    if (op == DESK + DESKTOP_NEW) {
      this.give(id, Answer(0, "/Desktop/" + text, u8[](), 0 as i64, 0 as i64, 0));
      return;
    }
    if (op == DESK + DESKTOP_PICK) {
      string chosen = this.picks.len() > 0 ? this.picks.remove(0) : "";
      this.give(id, Answer(0, chosen, u8[](), 0 as i64, 0 as i64, chosen == "" ? 1 : 0));
      return;
    }
    if (op == OP_CAPABILITY()) {
      this.give(id, Answer(0, PAGE_VERSION(), u8[](), BASE as i64, PAGE_COUNT as i64, 0));
      return;
    }
    if (op == OP_MONOTONIC_NANOS()) {
      this.give(id, Answer(0, "", u8[](), 0 as i64, 0 as i64, 0));
      return;
    }
    if (op < BASE || op >= BASE + PAGE_COUNT) { return; }
    Ticket<Answer> t = this.server.answer(op - BASE, a, b, text, bytes);
    ChildHost me = this;
    when(t, () => { me.give(id, t.value()); });
  }

  /** An answer: settled where it stands inside a request, and run on — the child's turn — from outside one. */
  void give(this, i32 id, Answer x) {
    if (id == 0) { return; }
    if (this.asking > 0 || this.page is null) {
      answered(this.host!, id, x.fault, x.text, x.bytes, x.n, x.m, x.flags);
      return;
    }
    Page p = this.page!;
    schedule p.take;
    answered(this.host!, id, x.fault, x.text, x.bytes, x.n, x.m, x.flags);
    p.drain();
    p.turn();
  }
}

Rig rig() {
  TestDoc doc = TestDoc.create();
  Page desk = doc.page();
  Element window = desk.root().append("div");
  Rig r = Rig(doc, desk, window, PageServer.into(desk, window, (string t) => { }, (string l) => { }), desk, "", null);
  Rig me = r;
  r.server.onTitle = (string t) => { me.title = t; };
  ChildHost c = ChildHost(r.server, null, null, 0, Vec.create(), "");
  Host h = Host.of(
    (i32 op, i32 id, i64 a, i64 b, string text, u8[] bytes) => {
      c.asking++;
      c.request(op, id, a, b, text, bytes);
      c.asking--;
    },
    (i32[] ids, i32 millis) => millis == 0 ? 0 - 1 : HOST_CANNOT_WAIT(),
    (i32 code) => { },
    () => false);
  c.host = h;
  Page child = Page.over(PageLine.of(h, BASE, 0), Sys.__wacOn(h));
  c.page = child;
  r.child = child;
  r.host = c;
  return r;
}

Node Counter(Ui ui) {
  auto n = ui.state(0);
  return <p>Clicks: <b id="count">{"\{n.get()}"}</b> <button id="up" onclick={(ElementEvent e) => { n.set(n.get() + 1); }}>+1</button></p>;
}

export string test_a_child_draws_in_its_window_and_hears_what_happens_there() {
  Check t = Check.create();
  Rig r = rig();
  schedule r.child.take;
  r.child.title("Counter");
  r.child.mount((Ui ui) => <Counter/>);
  r.child.turn();
  t.eqStr(r.title, "Counter", "the child's title is the window's");
  t.eqStr(r.doc.shown(r.window.id), "Clicks: 0 +1", "the child drew inside the window");
  t.eqStr(r.doc.shown(0), "Clicks: 0 +1", "and nowhere else");
  i32 up = r.doc.find("id", "up");
  t.isTrue(up >= 0, "its button is in the desktop's document");
  r.doc.fire(up, "click", "");
  t.eqStr(r.doc.shown(r.window.id), "Clicks: 1 +1", "a click there ran the child's handler, and it drew again");
  t.eqI32(r.server.refused.len(), 0, "nothing was refused: " + (r.server.refused.len() > 0 ? r.server.refused.get(0) : ""));
  return t.report();
}

export string test_what_a_child_may_not_do_is_refused_and_the_desktop_goes_on() {
  Check t = Check.create();
  Rig r = rig();
  // Asked of the server directly, as a child that skipped its own policy would: none of these may trap the desktop.
  r.server.answer(PAGE_MAKE, 5 as i64, pair(0, 0 - 1), "script", u8[]());
  r.server.answer(PAGE_MAKE, 6 as i64, pair(0, 0 - 1), "button", u8[]());
  r.server.answer(PAGE_ATTR, 6 as i64, 1 as i64, "onclick", "alert(1)".toBytes());
  r.server.answer(PAGE_ATTR, 9 as i64, 1 as i64, "title", "x".toBytes());
  r.server.answer(PAGE_REMOVE, 0 as i64, 0 as i64, "", u8[]());
  t.eqI32(r.server.refused.len(), 4, "four refusals, and one button made");
  t.isTrue(r.server.refused.get(0).indexOf("script") >= 0, "a script: " + r.server.refused.get(0));
  t.isTrue(r.server.refused.get(1).indexOf("onclick") >= 0, "a handler written: " + r.server.refused.get(1));
  t.isTrue(r.server.refused.get(2).indexOf("not live") >= 0, "a handle the child never made: " + r.server.refused.get(2));
  t.isTrue(r.server.refused.get(3).indexOf("stays") >= 0, "the window itself: " + r.server.refused.get(3));
  t.isTrue(r.doc.findTag("button") >= 0, "the button was made");
  t.eqI32(r.doc.findTag("script"), 0 - 1, "the script was not");
  return t.report();
}

async string takesTwo(Page page) {
  Picked a = await page.nextFile();
  Picked b = await page.nextFile();
  return a.name + "=" + string.fromBytes(a.bytes) + ";" + b.name + (b.ok ? "" : " failed: " + b.error);
}

export string test_a_file_handed_to_the_window_is_the_childs_next_file() {
  Check t = Check.create();
  Rig r = rig();
  // One handed before the child asks is kept for it; one after answers the request it is waiting on.
  r.server.hand(true, "a.txt", "hi".toBytes());
  schedule r.child.take;
  Ticket<string> got = takesTwo(r.child);
  r.child.drain();
  t.isFalse(got.settled(), "the first arrived, the second has not");
  r.server.hand(false, "b.bin", "NotReadableError".toBytes());
  t.isTrue(got.settled(), "the second answered what was waiting");
  t.eqStr(got.value(), "a.txt=hi;b.bin failed: NotReadableError", "both, in order, the second saying why it failed");
  return t.report();
}

async string picks(Sys sys) {
  match (await Desktop.of(sys)) {
    Ok(d): {
      Result<string, string> first = await d.pick("a note to read");
      Result<string, string> second = await d.pick("another");
      return (first.isOk() ? first.ok()! : first.err()!) + ";" + (second.isOk() ? second.ok()! : second.err()!);
    }
    Err(why): { return "no desktop: " + why; }
  }
}

export string test_a_program_finds_the_desktop_that_started_it_and_picks_with_it() {
  Check t = Check.create();
  Rig r = rig();
  r.host!.picks.push("Desktop/notes.txt");
  Runner run = Runner.create();
  schedule run.take;
  Ticket<string> got = picks(r.child.sys);
  run.drain();
  t.isTrue(got.settled(), "both picks were answered");
  t.eqStr(got.value(), "Desktop/notes.txt;nothing was chosen", "a path, then nothing chosen");
  return t.report();
}

async string opensEditsAndMakes(Sys sys) {
  match (await Desktop.of(sys)) {
    Ok(d): {
      await d.open("/Desktop/a.md");
      await d.edit("/Desktop/a.md");
      Result<string, string> made = await d.newFile("Untitled.txt");
      return made.isOk() ? made.ok()! : made.err()!;
    }
    Err(why): { return "no desktop: " + why; }
  }
}

export string test_a_program_opens_a_file_to_show_or_to_edit_and_asks_for_a_new_one() {
  Check t = Check.create();
  Rig r = rig();
  Runner run = Runner.create();
  schedule run.take;
  Ticket<string> got = opensEditsAndMakes(r.child.sys);
  run.drain();
  t.isTrue(got.settled(), "all three were answered");
  t.eqStr(r.host!.otherSlices, "open 0:/Desktop/a.md;open 1:/Desktop/a.md;", "shown, then as text to edit");
  t.eqStr(got.value(), "/Desktop/Untitled.txt", "and the new file's path is the desktop's answer");
  return t.report();
}

async string opensAWindow(Sys sys) {
  match (await Desktop.of(sys)) {
    Ok(d): {
      Result<Page, string> w = await d.openWindow("Second");
      if (w.isErr()) { return "no window: " + w.err()!; }
      Page p = w.ok()!;
      p.root().append("p");
      p.turn();
      return "";
    }
    Err(why): { return "no desktop: " + why; }
  }
}

export string test_a_program_opens_a_window_of_its_own_and_draws_in_that_windows_slice() {
  Check t = Check.create();
  Rig r = rig();
  Runner run = Runner.create();
  schedule run.take;
  Ticket<string> got = opensAWindow(r.child.sys);
  run.drain();
  t.isTrue(got.settled(), "the window was opened");
  t.eqStr(got.value(), "", "and drawn in");
  // Its next event and its location asked for, then its title and what it drew sent, all in slice 2 — the window the
  // desktop answered with.
  t.eqStr(r.host!.otherSlices, "2:\{PAGE_EVENT};2:\{PAGE_LOCATION};2:\{PAGE_BATCH};2:\{PAGE_BATCH};",
          "the window's requests went to its own slice");
  t.eqI32(r.doc.findTag("p"), 0 - 1, "and not to the first window's");
  return t.report();
}
