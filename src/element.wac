// A handle to one element of the page, and the authority over everything under it.
//
// **Holding an `Element` is the right to change that element and its subtree, and to hear their events
// — nothing above it or beside it** (`design/system/0012`). `page.root()` hands a program the root; a
// child made through a handle comes back as a handle; passing one to a widget is a grant, as passing
// `Sys` is. There is no `querySelector`, no `parentNode`, no `innerHTML`, and no page-wide string that
// names an element.
//
// **The program mints the handles.** A handle is a number this side chooses, and the document records
// the element it made under it — so making and changing elements never waits. Each change is a `wac.page`
// request nobody answers (`line.wac`), sent as it is made; a host batches them as it likes. Only reads
// wait, and each is a ticket.
//
// **A handle lives as long as its element is in the tree.** `remove` ends it and every handle under it,
// and a call on an ended handle traps saying which. The program keeps a mirror — parents and children,
// no attributes — which is what makes ending a subtree possible, and what tells the document when a
// handle can be forgotten.
//
// **Policy is here, and the browser enforces it again.** `attr` refuses an `on…` name, a name outside
// `[a-z][a-z0-9-]*`, and `javascript:` in a URL attribute; `append` refuses the elements that run or
// load something on their own. The build writes a Content Security Policy as well, so a page with no
// network grant cannot send anything anywhere even if this were wrong.

import { Queue, Ticket, Vec } from "core";
import { Answer } from "std";
import { Happened, PageLine, happenedOf } from "./line.wac";

/** What the document does with an event of a kind, decided before any event happens. */
export struct Listen {
  /**
   * The keys whose default the document prevents, for a key event — `"Tab ArrowUp ArrowDown"` — or
   * `"*"` for every event of the kind, or `""` for none. A worker learns of an event after the browser
   * has acted on it, so this cannot be decided per event.
   *
   * **A key may name its modifiers**: `"Ctrl+s Ctrl+l"` prevents those and not a plain `s` or `l`. A key
   * with modifiers matches only when exactly those are held, of `Ctrl`, `Alt`, `Shift` and `Meta`; a key
   * without them matches whatever is held, as it always has. A single letter matches either case. The
   * handler tells the two apart by `ElementEvent.mods`.
   */
  string prevent;

  Listen none() { return Listen(""); }
  Listen all() { return Listen("*"); }
  Listen keys(string names) { return Listen(names); }
}

/** Something that happened on an element. */
export struct ElementEvent {
  /** What was listened for: `"click"`, `"input"`, `"keydown"`… */
  string kind;
  /** The handle it happened on: the listener or something under it. */
  Element target;
  /** An input's value for `input` and `change`; the key for a key event, as the browser names it. */
  string value;
  /**
   * Where the pointer is, in the pixels of the element that listened — not of whatever smaller element
   * it is over — for a pointer event; 0 otherwise. A canvas's are its backing store's.
   */
  i32 x;
  i32 y;
  /** The modifier keys held, as `MOD_*` bits from `page.wac`. */
  i32 mods;
  /**
   * **Where the caret is**, in a text field the event happened in — an `<input>` or a `<textarea>` — as the
   * field's `selectionStart` and `selectionEnd`, equal when nothing is selected; -1 for an element that has
   * none. Counted as the browser counts, in UTF-16 code units, not bytes.
   *
   * Read when the event happens, so a `keydown` sees the caret before the key acts and a `keyup`, `input`
   * or `click` sees it after.
   */
  i32 selStart;
  i32 selEnd;
}

/** Every live handle, by id, and what the program has seen. */
export struct Elements {
  /** Where the changes go, and the events come from. */
  PageLine line;
  /** Each handle by its number; ended ones are null. Index 0 is the root. */
  Vec<Element?> byId;
  /** The number of the last event delivered to the program — what `prop` measures typing against. */
  i32 seen;

  /** The handles over `line`, the root among them, hearing the document's events from here on. */
  Elements create(PageLine line) {
    Vec<Element?> byId = Vec.create();
    Elements es = Elements(line, byId, 0);
    Element root = Element.made(es, 0, "", null);
    byId.push(root);
    es.follow();
    return es;
  }

  /**
   * **One event asked for at a time**, and the next asked for once it is delivered: the host keeps what
   * happens meanwhile, and a host that never answers — a page with no document — is never called back.
   */
  void follow(this) {
    Elements es = this;
    Ticket<Answer> t = this.line.event();
    t.whenSettled(() => {
      Happened h = happenedOf(t.value());
      es.deliver(h.seq, h.kind, h.target, h.listener, h.value, h.x, h.y, h.mods, h.selStart, h.selEnd);
      es.follow();
    });
  }

  Element root(this) { return this.byId.get(0)!; }

  i32 mint(this) {
    this.byId.push(null);
    return this.byId.len() - 1;
  }

  /**
   * An event from the document: `kind` on `targetId`, heard by the listener on `listenerId`, numbered
   * `seq`. One on a handle the program has already ended is dropped — a late click cannot reach a row
   * that is gone.
   */
  void deliver(this, i32 seq, string kind, i32 targetId, i32 listenerId, string value, i32 x, i32 y, i32 mods,
               i32 selStart, i32 selEnd) {
    if (seq > this.seen) { this.seen = seq; }
    if (listenerId < 0 || listenerId >= this.byId.len() || targetId < 0 || targetId >= this.byId.len()) { return; }
    Element? l = this.byId.get(listenerId);
    Element? t = this.byId.get(targetId);
    if (l is null || t is null) { return; }
    l!.heard(ElementEvent(kind, t!, value, x, y, mods, selStart, selEnd));
  }
}

/** One element, as far as this handle reaches. */
export struct Element {
  Elements es;
  i32 id;
  /** The element's tag, or `""` for a text node. */
  string tag;
  Element? parent;
  /** The children made through handles, in document order: the mirror. */
  Vec<Element> kids;
  bool live;
  /** The kinds listened for, and how. */
  Vec<string> kinds;
  /** A handler per kind, beside `kinds` — for one listened for with `listen`, the queue `next()` reads. */
  Vec<fn<void(ElementEvent)>> handlers;
  /** Events that arrived while nothing waited, and the tickets `next()` handed out. */
  Queue<ElementEvent> arrived;
  Queue<Ticket<ElementEvent>> waiting;

  Element made(Elements es, i32 id, string tag, Element? parent) {
    Vec<Element> kids = Vec.create();
    Vec<string> kinds = Vec.create();
    Vec<fn<void(ElementEvent)>> handlers = Vec.create();
    Queue<ElementEvent> arrived;
    Queue<Ticket<ElementEvent>> waiting;
    return Element(es, id, tag, parent, kids, true, kinds, handlers, arrived, waiting);
  }

  void alive(this, string what) {
    if (!this.live) { trap "Element." + what + ": handle " + "\{this.id}" + " was removed"; }
  }

  // ── Children ───────────────────────────────────────────────────────────────

  /** A child element, last. */
  Element append(this, string tag) { return this.insert(tag, null); }

  /** A child element before `before`, which must be a child of this one; last when null. */
  Element insert(this, string tag, Element? before) {
    this.alive("insert");
    if (this.tag == "" && this.id != 0) { trap "Element.insert: a text node has no children"; }
    refuseTag("Element.append", tag);
    i32 at = this.positionOf(before, "insert");
    Element e = Element.made(this.es, this.es.mint(), tag, this);
    this.es.byId.set(e.id, e);
    this.place(e, at);
    this.es.line.make(e.id, this.id, tag, before is null ? -1 : before!.id);
    return e;
  }

  /** A text child the program can change later, last, or before `before`. */
  Element appendText(this, string text) { return this.insertText(text, null); }

  Element insertText(this, string text, Element? before) {
    this.alive("insertText");
    i32 at = this.positionOf(before, "insertText");
    Element e = Element.made(this.es, this.es.mint(), "", this);
    this.es.byId.set(e.id, e);
    this.place(e, at);
    this.es.line.makeText(e.id, this.id, text, before is null ? -1 : before!.id);
    return e;
  }

  /** Replace everything under this element with text — ending every handle under it — or set a text node's. */
  void text(this, string s) {
    this.alive("text");
    for (i32 i = 0; i < this.kids.len(); i++) { this.kids.get(i).end(); }
    this.kids.clear();
    this.es.line.text(this.id, s);
  }

  /** Move this element before `before` within its parent, or last when null. */
  void move(this, Element? before) {
    this.alive("move");
    if (this.parent is null) { trap "Element.move: the root has no parent"; }
    Element p = this.parent!;
    i32 from = p.indexOfKid(this);
    p.kids.remove(from);
    i32 at = p.positionOf(before, "move");
    p.place(this, at);
    this.es.line.move(this.id, before is null ? -1 : before!.id);
  }

  /** Remove this element and everything under it; every handle there ends. */
  void remove(this) {
    this.alive("remove");
    if (this.parent is null) { trap "Element.remove: the root cannot be removed"; }
    Element p = this.parent!;
    p.kids.remove(p.indexOfKid(this));
    this.end();
    this.es.line.remove(this.id);
  }

  // ── What it is ─────────────────────────────────────────────────────────────

  /** Set attribute `name`, or remove it with `null`. */
  void attr(this, string name, string? value) {
    this.alive("attr");
    refuseAttr("Element.attr", name, value);
    this.es.line.attr(this.id, name, value ?? "", value is not null);
  }

  /** Set a property: `value`, `checked` (`"true"`/`"false"`) or `selected`. */
  void prop(this, string name, string value) {
    this.alive("prop");
    if (name != "value" && name != "checked" && name != "selected") {
      trap "Element.prop: " + name + " is not a property this sets — value, checked or selected";
    }
    this.es.line.prop(this.id, name, value, this.es.seen);
  }

  /**
   * Select `start` to `end` of this text field — the caret alone, when they are equal — counted as
   * `ElementEvent.selStart` is. Like a `value` set by a render, it does not land if the user has typed here
   * since the last event the program saw: a caret moved by a program behind the typing would put the next
   * keystroke in the wrong place.
   */
  void select(this, i32 start, i32 end) {
    this.alive("select");
    this.es.line.select(this.id, start, end, this.es.seen);
  }

  /**
   * Type `text` into this text field at its caret, replacing what is selected — as the browser would for a
   * keystroke, so it joins the field's undo history and an `input` event follows. Setting `value` instead wipes
   * that history, which is why an editor's Tab uses this.
   *
   * Like `select`, it does not land over typing the program has not seen: typed after a key the user pressed
   * later, it would arrive in the wrong place. So a program typing for a key it intercepted can lose that key
   * when the user types on faster than the page answers, and never misplaces it. Where the browser can do the
   * key itself — Enter — let it, and type only what follows.
   */
  void typeText(this, string text) {
    this.alive("typeText");
    this.es.line.typeText(this.id, text, this.es.seen);
  }

  void focus(this) {
    this.alive("focus");
    this.es.line.focus(this.id);
  }

  /** Scroll the page until this element's top is at the top of the window, as far as it will go. */
  void scrollIntoView(this) {
    this.alive("scrollIntoView");
    this.es.line.scroll(this.id, "");
  }

  /**
   * Scroll to the element under this one whose `id` attribute is `named` — a heading a link named, which
   * the program drew but holds no handle to. Nothing happens when there is none. Only this element's
   * subtree is searched, so this names nothing a handle to the element did not already reach.
   */
  void scrollToId(this, string named) {
    this.alive("scrollToId");
    if (named == "") { trap "Element.scrollToId: an empty name names nothing — scrollIntoView scrolls to the element itself"; }
    this.es.line.scroll(this.id, named);
  }

  /** Draw `rgba` — `w` by `h`, four bytes a pixel, row by row — as all of this canvas, sized to match. */
  void pixels(this, i32 w, i32 h, u8[] rgba) {
    this.drawable("pixels", w, h, rgba);
    this.es.line.pixels(this.id, w, h, rgba);
  }

  /**
   * Draw `rgba`, `w` by `h`, into this canvas with its corner at `x`, `y`; the rest stays as it was. Each of
   * the four is 0 to 65535, which is what `PAGE_PIXELS_IN` carries.
   */
  void pixelsIn(this, i32 x, i32 y, i32 w, i32 h, u8[] rgba) {
    this.drawable("pixelsIn", w, h, rgba);
    if (x < 0 || y < 0 || x > 65535 || y > 65535 || w > 65535 || h > 65535) {
      trap "Element.pixelsIn: \{x},\{y} \{w}x\{h} — each is 0 to 65535";
    }
    this.es.line.pixelsIn(this.id, x, y, w, h, rgba);
  }

  void drawable(this, string what, i32 w, i32 h, u8[] rgba) {
    this.alive(what);
    if (this.tag != "canvas") { trap "Element." + what + ": a " + this.tag + " is not a canvas"; }
    if (w < 0 || h < 0 || rgba.len() != w * h * 4) {
      trap "Element." + what + ": \{rgba.len()} bytes is not \{w}x\{h} pixels";
    }
  }

  /** The element's value as the document has it now — a round trip, so a ticket. */
  Ticket<string> value(this) {
    this.alive("value");
    Ticket<string> t;
    Ticket<Answer> a = this.es.line.value(this.id);
    a.whenSettled(() => { t.resolve(a.value().text); });
    return t;
  }

  // ── Events ─────────────────────────────────────────────────────────────────

  /** Deliver `kind` events from this element and everything under it, to be taken with `next()`. */
  void listen(this, string kind, Listen how) {
    Element me = this;
    this.on(kind, how, (ElementEvent e) => { me.queue(e); });
  }

  /** Deliver `kind` events from this element and everything under it to `handler`. */
  void on(this, string kind, Listen how, fn<void(ElementEvent)> handler) {
    this.alive("listen");
    for (i32 i = 0; i < this.kinds.len(); i++) {
      if (this.kinds.get(i) == kind) { this.handlers.set(i, handler); return; }
    }
    this.kinds.push(kind);
    this.handlers.push(handler);
    this.es.line.listen(this.id, kind, how.prevent);
  }

  /** The next event listened for with `listen`, as a ticket. */
  Ticket<ElementEvent> next(this) {
    Ticket<ElementEvent> t;
    if (this.arrived.len() > 0) { t.resolve(this.arrived.pop()!); } else { this.waiting.push(t); }
    return t;
  }

  void heard(this, ElementEvent e) {
    for (i32 i = 0; i < this.kinds.len(); i++) {
      if (this.kinds.get(i) == e.kind) {
        this.handlers.get(i)(e);
        return;
      }
    }
  }

  /** An event for `next()`: the oldest waiter takes it, or it waits for one. */
  void queue(this, ElementEvent e) {
    if (this.waiting.len() > 0) { this.waiting.pop()!.resolve(e); } else { this.arrived.push(e); }
  }

  // ── The mirror ─────────────────────────────────────────────────────────────

  bool isLive(const this) { return this.live; }
  Element? parentOf(this) { return this.parent; }
  i32 kidCount(this) { return this.kids.len(); }
  Element kidAt(this, i32 i) { return this.kids.get(i); }

  i32 indexOfKid(this, Element k) {
    for (i32 i = 0; i < this.kids.len(); i++) { if (this.kids.get(i) is k) { return i; } }
    trap "Element: a child the mirror does not hold";
  }

  i32 positionOf(this, Element? before, string what) {
    if (before is null) { return this.kids.len(); }
    if (before!.parent is null || before!.parent! is not this) {
      trap "Element." + what + ": the element to go before is not a child of this one";
    }
    return this.indexOfKid(before!);
  }

  void place(this, Element e, i32 at) {
    if (at >= this.kids.len()) { this.kids.push(e); } else { this.kids.insert(at, e); }
  }

  void end(this) {
    this.live = false;
    this.es.byId.set(this.id, null);
    for (i32 i = 0; i < this.kids.len(); i++) { this.kids.get(i).end(); }
  }
}

// ── Policy ───────────────────────────────────────────────────────────────────

bool lowerName(string s, bool colon) {
  u8[] b = s.toBytes();
  if (b.len() == 0 || b[0] < 'a' || b[0] > 'z') { return false; }
  for (i32 i = 1; i < b.len(); i++) {
    u8 c = b[i];
    bool ok = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || (colon && c == ':');
    if (!ok) { return false; }
  }
  return true;
}

/** The elements that run or load something on their own, which a page makes through no handle. */
export bool runsOnItsOwn(string tag) {
  return tag == "script" || tag == "iframe" || tag == "object" || tag == "embed" || tag == "base"
      || tag == "meta" || tag == "link" || tag == "frame" || tag == "frameset" || tag == "applet"
      || tag == "portal";
}

/**
 * Why a page may not make element `tag`, or `""` when it may. **Words rather than a trap**, for whoever is asked by
 * someone else — a host answering a child's `wac.page`, which must refuse a child's mistake and go on.
 */
export string whyNotTag(string tag) {
  if (!lowerName(tag, false)) { return tag + " is not an element name — [a-z][a-z0-9-]*"; }
  if (runsOnItsOwn(tag)) { return "a page cannot make a " + tag + " element"; }
  return "";
}

/** Trap, naming `who` — the call refusing — unless `tag` is an element a page may make. */
export void refuseTag(string who, string tag) {
  string why = whyNotTag(tag);
  if (why != "") { trap who + ": " + why; }
}

/** The attributes whose value is a URL a browser follows. */
export bool urlAttr(string name) {
  return name == "href" || name == "src" || name == "action" || name == "formaction" || name == "xlink:href"
      || name == "poster" || name == "data" || name == "cite" || name == "background";
}

/** Whether a URL runs script when followed: `javascript:`, in any case, after any leading spaces and controls. */
export bool scriptUrl(string v) {
  u8[] b = v.toBytes();
  i32 i = 0;
  while (i < b.len() && b[i] <= ' ') { i++; }
  string want = "javascript:";
  u8[] w = want.toBytes();
  i32 k = 0;
  while (i < b.len() && k < w.len()) {
    u8 c = b[i];
    // Tabs and newlines inside the scheme are stripped by a URL parser, so they do not hide it.
    if (c == '\t' || c == '\n' || c == '\r') { i++; continue; }
    u8 lc = c >= 'A' && c <= 'Z' ? c + 32 : c;
    if (lc != w[k]) { return false; }
    i++;
    k++;
  }
  return k == w.len();
}

/** Why a page may not set attribute `name` to `value`, or `""` when it may — `whyNotTag`'s companion. */
export string whyNotAttr(string name, string? value) {
  if (!lowerName(name, true)) { return name + " is not an attribute name — [a-z][a-z0-9-]*"; }
  if (name.len() >= 2 && name.slice(0, 2) == "on") { return name + " — a handler is listened for, not written"; }
  if (name == "srcdoc") { return "srcdoc writes a document"; }
  if (value is not null && urlAttr(name) && scriptUrl(value!)) { return name + " is a javascript: URL"; }
  return "";
}

/** Trap, naming `who`, unless `name` set to `value` is an attribute a page may write. */
export void refuseAttr(string who, string name, string? value) {
  string why = whyNotAttr(name, value);
  if (why != "") { trap who + ": " + why; }
}
