// `wac.desktop`: what a desktop does for a program it started, asked by name.
//
// **A program does not know it is on a desktop until it asks** (the desktop handover's design points 3 and 4).
// `Desktop.of(sys)` looks the capability up on the program's own host: a desktop that started it answers, and
// anything else — a standalone page, a command line — says it has none, which is a program's cue to do without.
// Holding a `Sys` is enough to ask, as it is to make a `Files`: no new authority.
//
// **A program starts with no window** (design point 2), and opens one — or several — when it wants: `openWindow` is a
// page drawn into a new window of the desktop's, as `Page.open` is the page a host provides. A page's program built
// by this package's builder opens its first window by opening its page, and a program with nothing to show opens
// none.
//
// **More than it is handed is asked for, once** (design point 6, as the owner answered it): `askFor` names a path and
// whether the program would change it too, the desktop asks the person, and their answer is remembered for the
// program — the next time it starts it holds what it was allowed, and is not asked again.
//
// **The picker is the grant.** `pick` shows the person the desktop's files; what they choose is answered as a path
// the program's `Files` can now read — and nothing else it could not before. So is `newFile`: a free name on the
// desktop, which the program may write and nothing beside it. `open` shows a path in the desktop's app for it, and
// `edit` in its editor; `note` says something in the desktop's own voice; `copy` and `paste` are the desktop's clipboard,
// which is text.
//
// Each request's fields, as `line.wac` gives `wac.page`'s. The desktop answers every request, `note` and `copy`
// included, since only what a program asks reaches a parent: a `host.tell` goes to the program's own host.

import { Answer, FAULT_NONE, OP_CAPABILITY, Sys, ask } from "std";
import { Result, Ticket } from "core";
import { PAGE_CAPABILITY, PAGE_WINDOW, PageLine } from "./line.wac";
import { Page } from "./page.wac";

export string DESKTOP_CAPABILITY() { return "wac.desktop"; }
export string DESKTOP_VERSION() { return "1.0.0"; }

/** `text` what the person is choosing for → `text` the path chosen; `flags` 1 when they chose nothing. */
export static i32 DESKTOP_PICK = 0;
/**
 * `text` a path the program may read → shown in the desktop's app for it — `a` 1: as text, in its editor; a fault
 * when it may not.
 */
export static i32 DESKTOP_OPEN = 1;
/** `text`: said in the desktop's note. */
export static i32 DESKTOP_NOTE = 2;
/** `text`: put on the desktop's clipboard. */
export static i32 DESKTOP_COPY = 3;
/** → `text`: what is on the desktop's clipboard. */
export static i32 DESKTOP_PASTE = 4;
/**
 * `text` a title → a window of the program's own: `n` which of its windows it is. The window's page is that window's
 * slice of `wac.page` — `PAGE_WINDOW` requests from the capability's base, times `n` — which `openWindow` makes.
 */
export static i32 DESKTOP_WINDOW = 5;
/**
 * `text` a path, `a` 1 to change what is there too → `flags` 0 when the program may from now on, 1 when not. The
 * desktop asks the person once and remembers their answer for this program.
 */
export static i32 DESKTOP_ASK = 6;
/**
 * `text` a name → `text` a path on the desktop for a new file of that name — or the first free name like it — which
 * the program may write from now on. Nothing is there until it writes it.
 */
export static i32 DESKTOP_NEW = 7;
/** How many request numbers the capability takes. */
export static i32 DESKTOP_COUNT = 8;

/** The desktop that started this program: its host, and where the capability's numbers start on it. */
export struct Desktop {
  Sys sys;
  i32 base;

  /** The desktop, if the program's host is one; `Err` says why not — run anywhere else, there is none. */
  async Result<Desktop, string> of(Sys sys) {
    Answer found = await ask(sys.host, OP_CAPABILITY(), 0 as i64, 0 as i64, DESKTOP_CAPABILITY(), "^1".toBytes());
    if (found.fault != FAULT_NONE()) { return Result.Err(found.text); }
    return Result.Ok(Desktop(sys, found.n as~ i32));
  }

  Ticket<Answer> ask(this, i32 op, string text) {
    return ask(this.sys.host, this.base + op, 0 as i64, 0 as i64, text, u8[]());
  }

  /**
   * Ask the person to choose a file, saying what for. The path they chose — which this program's files can read
   * from now on — or `Err` when they chose nothing.
   */
  async Result<string, string> pick(this, string what) {
    Answer a = await this.ask(DESKTOP_PICK, what);
    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }
    if (a.flags == 1) { return Result.Err("nothing was chosen"); }
    return Result.Ok(a.text);
  }

  /** Show `path` in the desktop's app for it. `Err` when this program may not read it. */
  async Result<void, string> open(this, string path) {
    Answer a = await this.ask(DESKTOP_OPEN, path);
    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }
    return Result.Ok();
  }

  /** Show `path` as text, in the desktop's editor. `Err` when this program may not read it. */
  async Result<void, string> edit(this, string path) {
    Answer a = await ask(this.sys.host, this.base + DESKTOP_OPEN, 1 as i64, 0 as i64, path, u8[]());
    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }
    return Result.Ok();
  }

  /**
   * Somewhere on the desktop for a new file named `name`: its path, which this program may write from now on — the
   * name as asked, or the first free one like it. `Err` saying why not.
   */
  async Result<string, string> newFile(this, string name) {
    Answer a = await this.ask(DESKTOP_NEW, name);
    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }
    return Result.Ok(a.text);
  }

  /** Say `text` in the desktop's note. */
  void note(this, string text) { this.ask(DESKTOP_NOTE, text); }

  /** Put `text` on the desktop's clipboard. */
  void copy(this, string text) { this.ask(DESKTOP_COPY, text); }

  /** What is on the desktop's clipboard. */
  async string paste(this) { return (await this.ask(DESKTOP_PASTE, "")).text; }

  /**
   * Ask to read `path` — and to change what is there too, when `write`. The person is asked once; `Ok` when the
   * program may from now on, `Err` saying why not.
   */
  async Result<void, string> askFor(this, string path, bool write) {
    Answer a = await ask(this.sys.host, this.base + DESKTOP_ASK, (write ? 1 : 0) as i64, 0 as i64, path, u8[]());
    if (a.fault != FAULT_NONE()) { return Result.Err(a.text); }
    if (a.flags != 0) { return Result.Err(a.text == "" ? "not allowed" : a.text); }
    return Result.Ok();
  }

  /**
   * A new window of this program's own, titled `title`: the page drawn into it, which renders itself from here on
   * (`Page.keepRendering`). `Err` when the desktop has no window to give.
   */
  async Result<Page, string> openWindow(this, string title) {
    // `wac.page` looked up first, which is what routes a window's requests to the desktop at all.
    Answer page = await ask(this.sys.host, OP_CAPABILITY(), 0 as i64, 0 as i64, PAGE_CAPABILITY(), "^1".toBytes());
    if (page.fault != FAULT_NONE()) { return Result.Err(page.text); }
    Answer w = await this.ask(DESKTOP_WINDOW, title);
    if (w.fault != FAULT_NONE()) { return Result.Err(w.text); }
    i32 base = (page.n as~ i32) + (w.n as~ i32) * PAGE_WINDOW;
    Page p = Page.over(PageLine.of(this.sys.host, base, page.flags), this.sys);
    p.title(title);
    p.keepRendering();
    return Result.Ok(p);
  }
}
