// `wac.page` answered by a program written in wac: another program's page, drawn into an element this one holds.
//
// **A desktop's window is this.** The desktop starts a page's module as a child (`Procs.spawnProviding`) and
// provides `wac.page` with `PageServer.provider`; the child's handle 0 is the element the desktop handed over — the
// window's body — and every element the child makes is one made under it here, through this program's own
// handles. So the child reaches nothing above or beside its window: the handle layer's rule, held across a process.
//
// **A child's mistake is refused, not trapped on.** A trap here would end the desktop, so each change is checked
// before it is made — a handle that is not live, a `<script>`, an `on…` attribute, a canvas drawn at the wrong
// size — and one that fails is dropped and noted in `refused`, the way a browser drops what its policy refuses.
//
// **What comes back is the child's to ask for**, as `line.wac` has it: its next event is answered from what its
// elements heard, a frame by this page's next frame, a value by the element's, a file by what the desktop hands it
// (`hand`). Its location never changes — a window has no address bar.
//
// **Full screen is asked of whoever this serves, never done by the child** (`whenFullScreen`): the child's element
// cannot fill a screen its window is inside of, and a desktop, not a program, decides when there is one to fill and how
// the person leaves it. The child hears the answer as its own element's `fullscreenchange` (`fullScreened`).
//
// **Its sounds are this page's**, made and played through it under this side's numbers, and they stop when the
// window closes: a closed window is not heard.

import { Answer, FAULT_UNSUPPORTED, Provider } from "std";
import { Map, Queue, Ticket, Vec, hashI32, i32Eq } from "core";
import { Element, ElementEvent, Listen, whyNotAttr, whyNotTag } from "./element.wac";
import { Page, Sound, Voice } from "./page.wac";
import { Change, Happened, PAGE_ATTR, PAGE_BATCH, PAGE_CAPABILITY, PAGE_COUNT, PAGE_DOWNLOAD, PAGE_EVENT, PAGE_FILE,
         PAGE_FOCUS, PAGE_FRAME, PAGE_LISTEN, PAGE_LOCATION, PAGE_LOG, PAGE_MAKE, PAGE_MAKE_TEXT, PAGE_MOVE,
         PAGE_FULLSCREEN, PAGE_GAIN, PAGE_GO, PAGE_PIXELS, PAGE_SURFACE, PAGE_PIXELS_IN, PAGE_PLAY, PAGE_PROP, PAGE_REMOVE, PAGE_SCROLL, PAGE_SELECT, PAGE_SOUND, PAGE_STOP, PAGE_TEXT, PAGE_TITLE,
         PAGE_TYPE_TEXT, PAGE_VALUE, PAGE_VERSION, batchOf, eventAnswer, getF64, highOf, lowOf, quadAt, when } from "./line.wac";

/** What a closed page's requests are answered. */
Answer closedAnswer() { return Answer(FAULT_UNSUPPORTED(), "the page was closed", u8[](), 0 as i64, 0 as i64, 0); }

/** How many refusals are kept: the latest, which is what someone looking at a misbehaving window wants. */
static i32 KEPT_REFUSALS = 32;

export struct PageServer {
  /** The page this program draws into: its frames, and its downloads, are the child's too. */
  Page page;
  /** The child's handles, by its numbers: 0 is the element handed over, a removed one is not live. */
  Vec<Element?> byId;
  /** Each element the child made, by this side's number for it: the child's number. */
  Map<i32, i32> childOf;
  /** Events heard that the child has not asked for yet, and its requests for the next one. */
  Queue<Happened> heard;
  Queue<Ticket<Answer>> asking;
  /** Files handed over that the child has not asked for yet, and its requests for the next one. */
  Queue<Answer> handed;
  Queue<Ticket<Answer>> wanting;
  i32 seq;
  /** Told each title the child gives its page — a window's caption. */
  fn<void(string)> onTitle;
  /** Told each line the child logs. */
  fn<void(string)> onLog;
  /** What the child asked for that was refused, latest last. */
  Vec<string> refused;
  /** Closed (`close`): every request answered "closed" from now on. */
  bool closed;
  /** The child's sounds, and the voices it played, by its numbers. */
  Map<i32, Sound> sounds;
  Map<i32, Voice> voices;
  /** How loud the child asked each of its voices to be, before `loudness` scales it. */
  Map<i32, f64> asked;
  /** **How loud this child is, all of it** (`louder`): what it asks for is scaled by this, 1 being as asked. */
  f64 loudness;
  /** The child, by the handle its parent spawned it as — what its canvases are handed to (`PAGE_SURFACE`) — or -1. */
  i32 child;
  /** Told the child's element and whether it asked to fill the screen or to leave it (`whenFullScreen`); none refuses. */
  fn<void(Element, bool)>? asksFull;
  /** The child's elements listening for `fullscreenchange`, by its numbers: told by `fullScreened`, not the document. */
  Vec<i32> hearFull;
  /**
   * **When the child last heard the person act** — a press, a click, a key but Escape: what a browser counts as the
   * person's own doing, and so when it lets a page fill the screen — by the page's clock, or -1. Known here before the
   * child is told, so whoever decides its full screen (`whenFullScreen`) can ask whether its request came just after.
   */
  f64 heardAt;

  /** A server drawing the child into `root`, which this program holds and the child may fill as it likes. */
  PageServer into(Page page, Element root, fn<void(string)> onTitle, fn<void(string)> onLog) {
    Vec<Element?> byId = Vec.create();
    byId.push(root);
    Queue<Happened> heard;
    Queue<Ticket<Answer>> asking;
    Queue<Answer> handed;
    Queue<Ticket<Answer>> wanting;
    return PageServer(page, byId, Map.create(hashI32, i32Eq), heard, asking, handed, wanting, 0, onTitle, onLog,
                      Vec.create(), false, Map.create(hashI32, i32Eq), Map.create(hashI32, i32Eq), Map.create(hashI32, i32Eq), 1.0, 0 - 1,
                      null, Vec.create(), 0.0 - 1.0);
  }

  /**
   * The child this server draws, by the handle its parent spawned it as (`Child.handle`): its canvases are handed to
   * its own worker to draw (`PAGE_SURFACE`). Until it is told, a child's canvases are drawn through this server.
   */
  void forChild(this, i32 handle) { this.child = handle; }

  /**
   * **Who decides the child's full screen** (`PAGE_FULLSCREEN`): told the element it asked for and whether it asked to
   * fill the screen or to leave it, as it asks. Whatever it decides, it says so with `fullScreened`.
   */
  void whenFullScreen(this, fn<void(Element, bool)> ask) { this.asksFull = ask; }

  /**
   * The child's page fills the screen now, or no longer does: each of its elements listening for `fullscreenchange`
   * hears it, `"1"` or `""`, as a browser's page hears its own — whether the child asked or the person left it.
   */
  void fullScreened(this, bool on) {
    for (i32 i = 0; i < this.hearFull.len(); i++) {
      i32 listener = this.hearFull.get(i);
      if (this.at(listener) is null) { continue; }
      this.seq++;
      this.told(Happened(this.seq, "fullscreenchange", listener, listener, on ? "1" : "", 0, 0, 0, 0 - 1, 0 - 1,
                         this.page.now(), 0 - 1));
    }
  }

  /** What `Procs.spawnProviding` is handed, so the child finds this as `wac.page`. */
  Provider provider(this) {
    PageServer s = this;
    return Provider(PAGE_CAPABILITY(), PAGE_VERSION(), PAGE_COUNT,
                    (i32 k, i64 a, i64 b, string text, u8[] bytes) => s.answer(k, a, b, text, bytes));
  }

  /**
   * **The window is gone.** What the child is waiting for — its next event, its next file — is answered "closed",
   * as is everything it asks from now on, so its page knows (`Page.closed`) instead of waiting for ever.
   */
  void close(this) {
    this.closed = true;
    Voice[] playing = this.voices.values();
    for (i32 i = 0; i < playing.len(); i++) { playing[i].stop(); }
    this.voices = Map.create(hashI32, i32Eq);
    this.asked = Map.create(hashI32, i32Eq);
    while (true) {
      Ticket<Answer>? t = this.asking.pop();
      if (t is null) { break; }
      t!.resolve(closedAnswer());
    }
    while (true) {
      Ticket<Answer>? t = this.wanting.pop();
      if (t is null) { break; }
      t!.resolve(closedAnswer());
    }
  }

  /** The child's request `k` of the capability, answered — at once, or when what it waits for arrives. */
  Ticket<Answer> answer(this, i32 k, i64 a, i64 b, string text, u8[] bytes) {
    if (this.closed) {
      Ticket<Answer> t;
      t.resolve(closedAnswer());
      return t;
    }
    if (k == PAGE_BATCH) {
      Change[] changes = batchOf(bytes);
      for (i32 i = 0; i < changes.len(); i++) {
        Change c = changes[i];
        this.change(c.op, c.a, c.b, c.text, c.bytes);
      }
      return done("");
    }
    if (k == PAGE_VALUE) {
      Element? e = this.at(lowOf(a));
      if (e is null) { return done(""); }
      Ticket<Answer> t;
      Ticket<string> v = e!.value();
      when(v, () => { t.resolve(Answer(0, v.value(), u8[](), 0 as i64, 0 as i64, 0)); });
      return t;
    }
    if (k == PAGE_EVENT) {
      Ticket<Answer> t;
      Happened? h = this.heard.pop();
      if (h is not null) {
        t.resolve(eventAnswer(h!));
        return t;
      }
      this.asking.push(t);
      return t;
    }
    if (k == PAGE_FRAME) {
      Ticket<Answer> t;
      Ticket<f64> f = this.page.nextFrame();
      when(f, () => { t.resolve(Answer(0, "", u8[](), 0 as i64, 0 as i64, 0)); });
      return t;
    }
    if (k == PAGE_LOCATION) {
      // The location is always the empty one: answered only to a child that thinks it is somewhere else.
      if (text != "") { return done(""); }
      Ticket<Answer> never;
      return never;
    }
    if (k == PAGE_FILE) {
      Ticket<Answer> t;
      Answer? f = this.handed.pop();
      if (f is not null) {
        t.resolve(f!);
        return t;
      }
      this.wanting.push(t);
      return t;
    }
    if (k >= 0 && k < PAGE_COUNT) {
      this.change(k, a, b, text, bytes);
      return done("");
    }
    Ticket<Answer> t;
    t.resolve(Answer(FAULT_UNSUPPORTED(), "wac.page has no request \{k}", u8[](), 0 as i64, 0 as i64, 0));
    return t;
  }

  /** The child's live element `h`, or null. */
  Element? at(this, i32 h) {
    if (h < 0 || h >= this.byId.len()) { return null; }
    Element? e = this.byId.get(h);
    if (e is null || !e!.isLive()) { return null; }
    return e;
  }

  void refuse(this, string why) {
    if (this.refused.len() >= KEPT_REFUSALS) { this.refused.remove(0); }
    this.refused.push(why);
  }

  /** Record `e` as the child's `h`. A number already taken by a live element is the child's mistake. */
  bool adopt(this, i32 h, Element e) {
    if (h <= 0 || h > this.byId.len() + 4096) {
      this.refuse("handle \{h} is not one the child could have made");
      return false;
    }
    while (this.byId.len() <= h) { this.byId.push(null); }
    if (this.at(h) is not null) {
      this.refuse("handle \{h} is already in use");
      return false;
    }
    this.byId.set(h, e);
    this.childOf.set(e.id, h);
    return true;
  }

  /** A sound made, played or stopped: the child's numbers for them, this page's sounds and voices. */
  void audio(this, i32 k, i64 a, i64 b, u8[] bytes) {
    if (k == PAGE_SOUND) {
      i32 rate = b as~ i32;
      if (rate < 3000 || rate > 192000) {
        this.refuse("sound: \{rate} is not a sample rate a page plays");
        return;
      }
      f64[] samples = f64[].filled(bytes.len() / 2, 0.0);
      for (i32 i = 0; i < samples.len(); i++) {
        i32 v = (bytes[i * 2] as i32) | ((bytes[i * 2 + 1] as i32) << 8);
        if (v >= 32768) { v = v - 65536; }
        samples[i] = (v as f64) / 32767.0;
      }
      this.sounds.set(a as~ i32, this.page.sound(samples, rate));
      return;
    }
    if (k == PAGE_PLAY) {
      Sound? sound = this.sounds.get(lowOf(a));
      if (sound is null) {
        this.refuse("play: \{lowOf(a)} is not a sound of the child's");
        return;
      }
      f64 asked = (highOf(b) as f64) / 1000.0;
      f64 volume = asked * this.loudness;
      // When and from where, as the child asked: its clock and this page's are the same one.
      Voice v = bytes.len() >= 16 ? sound!.playAt(volume, lowOf(b) != 0, getF64(bytes, 0), getF64(bytes, 8))
                                  : (lowOf(b) != 0 ? sound!.loop(volume) : sound!.play(volume));
      this.voices.set(highOf(a), v);
      this.asked.set(highOf(a), asked);
      return;
    }
    if (k == PAGE_GAIN) {
      Voice? fading = this.voices.get(a as~ i32);
      if (fading is not null) {
        f64 asked = (highOf(b) as f64) / 1000.0;
        this.asked.set(a as~ i32, asked);
        fading!.fade(asked * this.loudness, lowOf(b));
      }
      return;
    }
    Voice? playing = this.voices.get(a as~ i32);
    if (playing is not null) {
      playing!.stop();
      this.voices.remove(a as~ i32);
      this.asked.remove(a as~ i32);
    }
  }

  /**
   * **Every sound the child makes, `loudness` as loud** — 0 silent, 1 as it asked — from now on, and what is playing
   * already faded there over `ms`. The child is not told: its own volumes stay its own, and this scales them.
   */
  void louder(this, f64 loudness, i32 ms) {
    this.loudness = loudness < 0.0 ? 0.0 : loudness;
    i32[] ids = this.voices.keys();
    for (i32 i = 0; i < ids.len(); i++) {
      Voice? v = this.voices.get(ids[i]);
      f64? asked = this.asked.get(ids[i]);
      if (v is not null && asked is not null) { v!.fade(asked! * this.loudness, ms); }
    }
  }

  /** One change, made through this program's own handles once it has been checked. */
  void change(this, i32 k, i64 a, i64 b, string text, u8[] bytes) {
    i32 h = lowOf(a);
    if (k == PAGE_SURFACE) {
      // **A child's canvas, handed to the child's own worker**, which draws it from then on: the one request here
      // that names the child, by the handle its parent spawned it as (`forChild`).
      Element? canvas = this.at(lowOf(a));
      if (canvas is null || canvas!.tag != "canvas" || this.child < 0) {
        this.refuse("surface: \{lowOf(a)} is not a canvas this server can hand its child");
        return;
      }
      canvas!.surfaceFor(this.child, lowOf(b));
      return;
    }
    if (k == PAGE_GO) {
      this.refuse("go: a window's page has no location of its own");
      return;
    }
    if (k == PAGE_FULLSCREEN) {
      Element? asked = this.at(h);
      if (asked is null || this.asksFull is null) {
        this.refuse("fullscreen: \{h} is not an element this server can ask full screen for");
        return;
      }
      this.asksFull!(asked!, b != 0 as i64);
      return;
    }
    if (k == PAGE_TITLE) {
      this.onTitle(text);
      return;
    }
    if (k == PAGE_LOG) {
      this.onLog(text);
      return;
    }
    if (k == PAGE_DOWNLOAD) {
      this.page.download(text, bytes);
      return;
    }
    if (k == PAGE_SOUND || k == PAGE_PLAY || k == PAGE_STOP || k == PAGE_GAIN) {
      this.audio(k, a, b, bytes);
      return;
    }
    if (k == PAGE_MAKE || k == PAGE_MAKE_TEXT) {
      Element? parent = this.at(highOf(b));
      if (parent is null || parent!.tag == "") {
        this.refuse("make: \{highOf(b)} is not an element of the child's that can hold children");
        return;
      }
      Element? before = null;
      if (lowOf(b) >= 0) {
        before = this.at(lowOf(b));
        if (before is null || before!.parentOf() is null || before!.parentOf()! is not parent!) {
          this.refuse("make: \{lowOf(b)} is not a child of \{highOf(b)}");
          return;
        }
      }
      if (k == PAGE_MAKE) {
        string why = whyNotTag(text);
        if (why != "") {
          this.refuse("make: " + why);
          return;
        }
        Element made = parent!.insert(text, before);
        if (!this.adopt(h, made)) { made.remove(); }
        return;
      }
      Element madeText = parent!.insertText(text, before);
      if (!this.adopt(h, madeText)) { madeText.remove(); }
      return;
    }
    Element? found = this.at(h);
    if (found is null) {
      this.refuse("request \{k}: handle \{h} is not live");
      return;
    }
    Element e = found!;
    if (k == PAGE_TEXT) {
      e.text(text);
      return;
    }
    if (k == PAGE_ATTR) {
      string value = string.fromBytes(bytes);
      string why = whyNotAttr(text, b != 0 as i64 ? value : null);
      if (why != "") {
        this.refuse("attr: " + why);
        return;
      }
      e.attr(text, b != 0 as i64 ? value : null);
      return;
    }
    if (k == PAGE_PROP) {
      if (text != "value" && text != "checked" && text != "selected") {
        this.refuse("prop: " + text + " is not a property a page sets");
        return;
      }
      e.prop(text, string.fromBytes(bytes));
      return;
    }
    if (k == PAGE_MOVE || k == PAGE_REMOVE) {
      if (h == 0) {
        this.refuse("the element handed over stays where it is");
        return;
      }
      if (k == PAGE_REMOVE) {
        e.remove();
        return;
      }
      Element? to = null;
      if (lowOf(b) >= 0) {
        to = this.at(lowOf(b));
        if (to is null || to!.parentOf() is null || e.parentOf() is null || to!.parentOf()! is not e.parentOf()!) {
          this.refuse("move: \{lowOf(b)} is not beside \{h}");
          return;
        }
      }
      e.move(to);
      return;
    }
    if (k == PAGE_LISTEN && text == "fullscreenchange") {
      // Never the document's to say: the child's element is not what fills the screen (`fullScreened`).
      for (i32 i = 0; i < this.hearFull.len(); i++) { if (this.hearFull.get(i) == h) { return; } }
      this.hearFull.push(h);
      return;
    }
    if (k == PAGE_LISTEN) {
      PageServer s = this;
      i32 listener = h;
      e.on(text, Listen(string.fromBytes(bytes)), (ElementEvent ev) => { s.heardOn(listener, ev); });
      return;
    }
    if (k == PAGE_FOCUS) {
      e.focus();
      return;
    }
    if (k == PAGE_SCROLL) {
      if (text == "") { e.scrollIntoView(); } else { e.scrollToId(text); }
      return;
    }
    if (k == PAGE_SELECT) {
      e.select(highOf(b), lowOf(b));
      return;
    }
    if (k == PAGE_TYPE_TEXT) {
      e.typeText(text);
      return;
    }
    if (k == PAGE_PIXELS || k == PAGE_PIXELS_IN) {
      i32 x = k == PAGE_PIXELS ? 0 : quadAt(b, 0);
      i32 y = k == PAGE_PIXELS ? 0 : quadAt(b, 1);
      i32 w = k == PAGE_PIXELS ? highOf(b) : quadAt(b, 2);
      i32 ht = k == PAGE_PIXELS ? lowOf(b) : quadAt(b, 3);
      if (e.tag != "canvas" || w < 0 || ht < 0 || bytes.len() != w * ht * 4) {
        this.refuse("pixels: \{bytes.len()} bytes is not \{w}x\{ht} pixels of a canvas");
        return;
      }
      if (k == PAGE_PIXELS) { e.pixels(w, ht, bytes); } else { e.pixelsIn(x, y, w, ht, bytes); }
      return;
    }
    this.refuse("wac.page has no change \{k}");
  }

  /**
   * A file the person handed the child — dropped on its window, say — or, with `ok` false, one that could not be
   * read, saying why in `bytes`: its `nextFile`, now if it is asking, or when it does.
   */
  void hand(this, bool ok, string name, u8[] bytes) {
    Answer a = Answer(0, name, bytes, 0 as i64, 0 as i64, ok ? 0 : 1);
    Ticket<Answer>? t = this.wanting.pop();
    if (t is not null) {
      t!.resolve(a);
      return;
    }
    this.handed.push(a);
  }

  /** An event heard by the child's listener `listener`, for the child — told now if it is asking, or kept. */
  void heardOn(this, i32 listener, ElementEvent ev) {
    string k = ev.kind;
    if (k == "pointerdown" || k == "pointerup" || k == "click" || k == "dblclick" || k == "contextmenu"
        || ((k == "keydown" || k == "keyup") && ev.value != "Escape")) {
      this.heardAt = this.page.now();
    }
    i32? target = this.childOf.get(ev.target.id);
    this.seq++;
    Happened h = Happened(this.seq, ev.kind, target ?? listener, listener, ev.value, ev.x, ev.y, ev.mods, ev.selStart,
                          ev.selEnd, ev.at, ev.pointer);
    this.told(h);
  }

  /** `h` for the child: answered now if it is asking for its next event, or kept until it does. */
  void told(this, Happened h) {
    Ticket<Answer>? t = this.asking.pop();
    if (t is not null) {
      t!.resolve(eventAnswer(h));
      return;
    }
    this.heard.push(h);
  }
}

/** An answer with nothing in it but `text`, already settled. */
Ticket<Answer> done(string text) {
  Ticket<Answer> t;
  t.resolve(Answer(0, text, u8[](), 0 as i64, 0 as i64, 0));
  return t;
}
