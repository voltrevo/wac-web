// Build a page: `<entry.wac>` exporting `async i32 main(Page page)` becomes one `index.html` that runs it.
//
//     wac run --allow-read --allow-write --allow-run tools/build.wac src/app.wac dist
//
// **Three steps, all of them visible in the output directory.** `page.wac` is the page's program as a module
// (`moduleFor`): it opens the page its host provides and runs the program's `main` with it. `wac build` makes it
// `page.wasm`. `index.html` is that module, as base64, and the host — the browser's side, written below — so the
// page is a single file any static server, or none, can serve; and the same `page.wasm` runs in a desktop's window.
//
// **The program runs in a worker unless `--in-page` says otherwise.** A worker is the default because
// a page's program is a program: a loop that computes for a second, or forever, should cost the
// program its own responsiveness and not the tab's — scrolling, selecting and closing the tab keep
// working whatever it does. The worker is made from the page's own text, so there is still one file
// and nothing the server has to send. `--in-page` runs the same program on the page's own thread, for
// a page small enough that a worker is only overhead; nothing in the program changes either way,
// because the host is two halves that talk by messages, and in a page they are joined directly.
//
// **A program, not a script in someone else's language**, so a project outside this repository builds
// a page with the `wac` it already has and this package as a dependency (`template/`). It
// runs `wac build` as a command, which is why it needs `--allow-run`; `--wac <path>` names a binary
// other than the one on `PATH`, and `--page <spec>` the module the page's module imports `Page` from when the
// project does not map this package as `web`.

import { Exec, Sys, ChildEnv, Files, Launch, Output, Procs } from "std";
import { Vec, flatten } from "core";

// A site's `index.json`, which its build writes last (`index.wac`): exported here, as the package's one entry.
export { indexSite } from "./index.wac";

/** What a build was asked for. */
struct Asked {
  string entry;
  string out;
  string wac;
  string pageSpec;
  string title;
  /** Run the program on the page's own thread rather than in a worker. */
  bool inPage;
  /** What `page.sys` holds, as `GRANT_*` bits: none unless `--grant read,write` asks. */
  i32 grants;
  /**
   * The export a copy of this page started by `spawnSelf` runs — `async i32 <name>(Sys sys)` — or "" for
   * a page that starts nothing. A copy has no document, so it cannot run `main(Page …)`.
   */
  string spawn;
  /** A development build: the page checks its views after every turn (`Page.checking`). */
  bool dev;
}

/** The arguments, or a usage line in `title` and empty `entry` when they do not make sense. */
Asked askedOf(string[] argv) {
  Asked a = Asked("", "", "wac", "web", "wac", false, 0, "", false);
  i32 argc = argv.len();
  string[] args = string[].filled(argc, "");
  for (i32 k = 0; k < argc; k++) { args[k] = argv[k]; }
  i32 i = 0;
  i32 positional = 0;
  while (i < argc) {
    string w = args[i];
    if ((w == "--wac" || w == "--page" || w == "--title") && i + 1 < argc) {
      string v = args[i + 1];
      if (w == "--wac") { a.wac = v; } else if (w == "--page") { a.pageSpec = v; } else { a.title = v; }
      i += 2;
      continue;
    }
    if (w == "--spawn" && i + 1 < argc) {
      a.spawn = args[i + 1];
      i += 2;
      continue;
    }
    if (w == "--in-page") {
      a.inPage = true;
      i++;
      continue;
    }
    if (w == "--dev") {
      a.dev = true;
      i++;
      continue;
    }
    // `--grant read,write` rather than `--allow-read`: after the entry, `wac run` takes `--allow-…` as
    // a grant spelled in the wrong place and refuses it, which is right — those are the builder's own.
    if (w == "--grant" && i + 1 < argc) {
      string[] names = partsOfList(args[i + 1]);
      for (string g in names) {
        if (g == "read") { a.grants = a.grants | 1; }
        else if (g == "write") { a.grants = a.grants | 2; }
        else { a.title = "unknown grant: " + g; a.entry = ""; }
      }
      i += 2;
      continue;
    }
    if (positional == 0) { a.entry = w; } else if (positional == 1) { a.out = w; }
    positional++;
    i++;
  }
  return a;
}

/** `read,write` as its names. */
string[] partsOfList(string s) {
  Vec<string> out = Vec.create();
  string rest = s;
  while (rest.len() > 0) {
    i32 cut = rest.indexOf(",");
    string p = cut < 0 ? rest : rest.slice(0, cut);
    if (p != "") { out.push(p); }
    rest = cut < 0 ? "" : rest.slice(cut + 1, rest.len());
  }
  string[] parts = string[].filled(out.len(), "");
  for (i32 i = 0; i < out.len(); i++) { parts[i] = out.get(i); }
  return parts;
}

/** The parts of a relative path, with `.` dropped and `..` taken against what comes before it. */
string[] partsOf(string path) {
  Vec<string> out = Vec.create();
  string rest = path;
  while (true) {
    i32 cut = rest.indexOf("/");
    string p = cut < 0 ? rest : rest.slice(0, cut);
    if (p == "..") {
      if (out.len() > 0 && out.get(out.len() - 1) != "..") { out.pop(); } else { out.push(p); }
    } else if (p != "" && p != ".") {
      out.push(p);
    }
    if (cut < 0) { break; }
    rest = rest.slice(cut + 1, rest.len());
  }
  string[] parts = string[].filled(out.len(), "");
  for (i32 i = 0; i < out.len(); i++) { parts[i] = out.get(i); }
  return parts;
}

/** Whether `path` is absolute or climbs above this directory. */
bool leavesHere(string path) {
  if (path.len() > 0 && path.slice(0, 1) == "/") { return true; }
  string[] parts = partsOf(path);
  return parts.len() > 0 && parts[0] == "..";
}

/** How a file in directory `from` names the file `to` — both relative to where the build runs. */
export string relativeTo(string from, string to) {
  string[] a = partsOf(from);
  string[] b = partsOf(to);
  i32 common = 0;
  while (common < a.len() && common + 1 < b.len() && a[common] == b[common]) { common++; }
  string out = "";
  for (i32 i = common; i < a.len(); i++) { out = out + "../"; }
  for (i32 i = common; i < b.len(); i++) { out = out + b[i] + (i + 1 < b.len() ? "/" : ""); }
  return out.len() >= 3 && out.slice(0, 3) == "../" ? out : "./" + out;
}

/**
 * **The page's program as a module**: a `main(Sys sys)` any host can start, which opens the page that host provides
 * (`Page.open`), runs the program's `main(Page page)` with it, and renders each time a view has something to render
 * (`Page.changed`) for as long as the page is open. `wac build` makes it a module like any other — so a standalone
 * page's host runs it as it runs every module it is handed, and a desktop can start the same file in a window.
 *
 * **A host with no page** — a copy of the page started by `spawnSelf`, which has no document, or a command line —
 * runs `spawn`'s export, `async i32 <spawn>(Sys sys)`, when the build names one, and otherwise says what it is and
 * stops.
 *
 * **It never returns while the page is open**: a page's program usually returns as soon as it has mounted its view,
 * and the page lives on in its handlers.
 */
export string moduleFor(string entrySpec, string pageSpec, string spawn, bool dev) {
  string withoutPage = spawn != "" ? "      return await \{spawn}(sys);\n"
    : "      sys.stderr().line(\"this is a page, and its host has none: \" + why);\n      return 1;\n";
  return "// Written by web's tools/build.wac — the page's program, as a module any host that provides `wac.page` runs.\n"
       + "import { main as program" + (spawn != "" ? ", " + spawn : "") + " } from \"\{entrySpec}\";\n"
       + "import { Page } from \"\{pageSpec}\";\n"
       + "import { Sys } from \"std\";\n\n"
       + "export async i32 main(Sys sys) {\n"
       + "  match (await Page.open(sys)) {\n"
       + "    Ok(page): { return await run(page); }\n"
       + "    Err(why): {\n" + withoutPage + "    }\n"
       + "  }\n"
       + "}\n\n"
       + "async i32 run(Page page) {\n"
       + (dev ? "  page.checking = true;\n" : "")
       + "  program(page);\n"
       + "  await page.keepRendering();\n"
       + "  return 0;\n"
       + "}\n";
}

/** `bytes` as base64, which is how the page carries its module: as text in an element the browser does not run. */
export string base64(u8[] bytes) {
  string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  u8[] a = alphabet.toBytes();
  i32 n = bytes.len();
  u8[] out = u8[].filled(((n + 2) / 3) * 4, '=' as u8);
  i32 o = 0;
  for (i32 i = 0; i < n; i += 3) {
    i32 b0 = bytes[i] as i32;
    i32 b1 = i + 1 < n ? bytes[i + 1] as i32 : 0;
    i32 b2 = i + 2 < n ? bytes[i + 2] as i32 : 0;
    out[o] = a[b0 >> 2];
    out[o + 1] = a[((b0 & 3) << 4) | (b1 >> 4)];
    if (i + 1 < n) { out[o + 2] = a[((b1 & 15) << 2) | (b2 >> 6)]; }
    if (i + 2 < n) { out[o + 3] = a[b2 & 63]; }
    o += 4;
  }
  return string.fromBytes(out);
}

/**
 * The program's half of the host: `wac.page` (`src/line.wac`) answered over the system's requests. Each change
 * the program asks for becomes a message for the document, and each event, frame, file, value and location the
 * document sends back answers the request waiting for it. It runs wherever the program does — in a worker, or
 * on the page — and touches nothing of the document itself; a frame is the document's to give, and the clock and
 * timers are the system's.
 *
 * `wacPageServer(next, answer, post, where, site)` answers the lookup and the capability's range, passes every
 * other request to `next`, sends the document what `post` takes, and starts at location `where`; it answers
 * `request`, and `receive` for what the document sends back. `site` is the page's own URL, or null for a page opened
 * from a file: what `wac.site` (`src/site.wac`) fetches from, relative to it and never outside its folder. A buffer is handed over rather than copied when it is the whole
 * of its own memory.
 */
export string programSide() {
  return """
      const wacPageServer = (next, answer, post, where, site) => {
        // **Where `wac.page`'s numbers start here** — above every request std numbers, below the 2^20 a parent
        // numbers the capabilities it provides from.
        const BASE = 4096, COUNT = 23;
        const NONE = new Uint8Array(0), dec = new TextDecoder(), enc = new TextEncoder();
        const lo = (v) => Number(BigInt.asIntN(32, v)), hi = (v) => Number(v >> 32n);
        const pair = (high, low) => (BigInt(high) << 32n) | BigInt(low >>> 0);
        const quadAt = (v, k) => Number((v >> BigInt(48 - 16 * k)) & 0xffffn);
        // **One message a turn.** The program runs until it waits; what it asked of the document meanwhile
        // goes as one batch, in order, when it does — so a diff that makes five hundred changes costs one
        // message, and an element made in a turn exists before a later call in that turn draws into it.
        let batch = null, moving = [];
        const send = (m, transfer) => {
          if (batch === null) {
            batch = [];
            queueMicrotask(() => { const b = batch, t = moving; batch = null; moving = []; post(["ops", b], t); });
          }
          batch.push(m);
          if (transfer) moving.push(...transfer);
        };
        // **What the document said that the program has not asked for yet**, and the requests waiting for it.
        // An event or a file is answered later, never inside the request that asked — so each runs the
        // program on in a turn of its own, and renders before the next.
        const events = [], eventAsks = [], files = [], fileAsks = [], frames = new Map(), values = new Map();
        let at = where, locationAsks = [], lastFrame = 0, lastValue = 0;
        const strip = (h) => h.startsWith("#") ? h.slice(1) : h;
        const giveEvent = (id, [seq, kind, target, listener, value, x, y, mods, selStart, selEnd]) => {
          const k = enc.encode(kind), b = new Uint8Array(12 + k.length), v = new DataView(b.buffer);
          v.setInt32(0, seq, true); v.setInt32(4, selStart, true); v.setInt32(8, selEnd, true);
          b.set(k, 12);
          answer(id, 0, value, b, pair(listener, target), pair(x, y), mods);
        };
        const giveFile = (id, [ok, name, bytes, error]) => answer(id, 0, name, ok ? bytes : enc.encode(error), 0n, 0n, ok ? 0 : 1);
        // A location is answered at once, even inside the request: the program learns where it is before it runs.
        const located = () => {
          const waiting = locationAsks;
          locationAsks = [];
          for (const w of waiting) { if (strip(at) !== w.known) answer(w.id, 0, strip(at), NONE, 0n, 0n, 0); else locationAsks.push(w); }
        };
        const flush = () => {
          while (eventAsks.length && events.length) giveEvent(eventAsks.shift(), events.shift());
          while (fileAsks.length && files.length) giveFile(fileAsks.shift(), files.shift());
        };
        const page = (k, id, a, b, text, bytes) => {
          switch (k) {
            case 0: return send(["make", lo(a), hi(b), text, lo(b)]);
            case 1: return send(["makeText", lo(a), hi(b), text, lo(b)]);
            case 2: return send(["text", lo(a), text]);
            case 3: return send(["attr", lo(a), text, dec.decode(bytes), b !== 0n]);
            case 4: return send(["prop", lo(a), text, dec.decode(bytes), hi(a)]);
            case 5: return send(["move", lo(a), lo(b)]);
            case 6: return send(["remove", lo(a)]);
            case 7: return send(["listenOn", lo(a), text, dec.decode(bytes)]);
            case 8: return send(["focus", lo(a)]);
            case 9: { const req = ++lastValue; values.set(req, id); return send(["valueOf", req, lo(a)]); }
            case 10: return send(["pixels", lo(a), hi(b), lo(b), bytes], wacOwn(bytes));
            case 11: return send(["pixelsIn", lo(a), quadAt(b, 0), quadAt(b, 1), quadAt(b, 2), quadAt(b, 3), bytes], wacOwn(bytes));
            case 12: return send(["scroll", lo(a), text]);
            case 13: return send(["select", lo(a), hi(b), lo(b), hi(a)]);
            case 14: return send(["typeText", lo(a), text, hi(a)]);
            case 15: return send(["title", text]);
            case 16: console.log(text); return;
            case 17: return send(["download", text, bytes], wacOwn(bytes));
            case 18: eventAsks.push(id); return queueMicrotask(flush);
            case 19: fileAsks.push(id); return queueMicrotask(flush);
            case 20: { const f = ++lastFrame; frames.set(f, id); return send(["frame", f]); }
            case 21: locationAsks.push({ id, known: text }); return located();
            // The changes the program held, in order, as each would have come alone; answered at once.
            case 22: {
              const v = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
              let at = 0;
              for (let i = 0; i < Number(a) && at + 21 <= bytes.length; i++) {
                const op = bytes[at], ca = v.getBigInt64(at + 1, true), cb = v.getBigInt64(at + 9, true);
                const tlen = v.getUint32(at + 17, true);
                const ctext = dec.decode(bytes.subarray(at + 21, at + 21 + tlen));
                const blen = v.getUint32(at + 21 + tlen, true), from = at + 25 + tlen;
                // A copy, not a view: a buffer handed to the document is moved, and this one is the batch's.
                page(op, 0, ca, cb, ctext, bytes.slice(from, from + blen));
                at = from + blen;
              }
              return answer(id, 0, "", NONE, 0n, 0n, 0);
            }
          }
        };
        // **`wac.site`**: a GET on the page's own origin, under its folder — the browser's cache does the caching.
        const SITE = BASE + 100;
        const siteDir = site === null ? null : new URL("./", site);
        const siteGet = (id, path) => {
          let rel = path;
          while (rel.startsWith("/")) rel = rel.slice(1);
          const u = new URL(rel, siteDir);
          if (!u.href.startsWith(siteDir.href)) return answer(id, 9, path + " is not under the page's site", NONE, 0n, 0n, 0);
          fetch(u).then((r) => r.ok
              ? r.arrayBuffer().then((buf) => answer(id, 0, "", new Uint8Array(buf), 0n, 0n, 0))
              : answer(id, 2, path + ": the site answered " + r.status, NONE, 0n, 0n, 0),
            (e) => answer(id, 5, path + ": " + String(e?.message ?? e), NONE, 0n, 0n, 0));
        };
        const allows = (versions) => {
          // `^1`, `^1.0`, `^1.0.0` or `1.0.0`: what a 1.0.0 capability here allows.
          const [major, minor, patch] = (versions.startsWith("^") ? versions.slice(1) : versions).split(".");
          return versions.startsWith("^") ? major === "1" && (minor ?? "0") === "0" && (patch ?? "0") === "0" : versions === "1.0.0";
        };
        const request = (op, id, a, b, text, bytes) => {
          if (op === 68 && text === "wac.site") {
            if (siteDir === null) return answer(id, 9, "a page opened from a file has no site", NONE, 0n, 0n, 0);
            if (!allows(dec.decode(bytes))) return answer(id, 9, "wac.site here is 1.0.0, which " + dec.decode(bytes) + " does not allow", NONE, 0n, 0n, 0);
            return answer(id, 0, "1.0.0", NONE, BigInt(SITE), 1n, 0);
          }
          if (op === SITE) return siteGet(id, text);
          if (op === 68 && text === "wac.page") {
            // `^1`, `^1.2`, or an exact `1.2.3`: this host speaks 1.0.0, which only `^1`, `^1.0`, `^1.0.0` and `1.0.0` allow.
            const v = dec.decode(bytes);
            const [major, minor, patch] = (v.startsWith("^") ? v.slice(1) : v).split(".");
            const allowed = v.startsWith("^") ? major === "1" && (minor ?? "0") === "0" && (patch ?? "0") === "0" : v === "1.0.0";
            if (!allowed) {
              return answer(id, 9, "wac.page here is 1.0.0, which " + v + " does not allow", NONE, 0n, 0n, 0);
            }
            return answer(id, 0, "1.0.0", NONE, BigInt(BASE), BigInt(COUNT), 0);
          }
          if (op >= BASE && op < BASE + COUNT) return page(op - BASE, id, a, b, text, bytes);
          return next(op, id, a, b, text, bytes);
        };
        const receive = (m) => {
          switch (m[0]) {
            case "el": events.push(m.slice(1)); return flush();
            case "file": files.push(m.slice(1)); return flush();
            case "where": at = m[1]; return located();
            case "value": { const id = values.get(m[1]); values.delete(m[1]); if (id !== undefined) answer(id, 0, m[2], NONE, 0n, 0n, 0); return; }
            case "timer": { const id = frames.get(m[1]); frames.delete(m[1]); if (id !== undefined) answer(id, 0, "", NONE, 0n, 0n, 0); return; }
          }
        };
        return { request, receive };
      };
      """;
}

/**
 * The system's half: `System`'s calls on the Origin Private File System,
 * each answered later through `answer(req, fault, text, bytes, n, m, flags)` — `system.wac` says what
 * each call's answer holds. It runs where the program does: a worker has the file system too.
 *
 * **A fault is a number from `std`'s table**, chosen here from the error the browser threw, and the
 * browser's own message rides along for a fault the table has no words for. Paths are relative to the
 * file system's root, which is also where a page's working directory is: `.` and empty parts are
 * dropped, `..` climbs and stops at the root.
 */
export string systemSide() {
  return """
      // A queue of byte chunks with one reader at a time: what a child's streams arrive on.
      const wacQueue = () => {
        const items = [], waiters = [];
        let ended = false;
        return {
          push(b) { if (waiters.length) waiters.shift()({ bytes: b }); else items.push(b); },
          // Put a piece back at the front: read on a reader's behalf, and not wanted after all.
          unshift(b) { if (waiters.length) waiters.shift()({ bytes: b }); else items.unshift(b); },
          end() { ended = true; while (waiters.length) waiters.shift()({ end: true }); },
          next() {
            if (items.length) return Promise.resolve({ bytes: items.shift() });
            if (ended) return Promise.resolve({ end: true });
            return new Promise((r) => waiters.push(r));
          },
        };
      };
      // Why `bytes` cannot be started as a program, or "": a wasm module carrying the manifest that describes it.
      const wacNotRunnable = (bytes) => {
        if (!WebAssembly.validate(bytes)) {
          return bytes.length >= 4 && bytes[0] === 0 && bytes[1] === 97 && bytes[2] === 115 && bytes[3] === 109
            ? "that is not a valid wasm module" : "a page starts wasm modules, and that is not one";
        }
        return WebAssembly.Module.customSections(new WebAssembly.Module(bytes), "wac.manifest").length > 0 ? ""
          : "that module carries no wac.manifest section, so a page cannot describe it";
      };
      const wacOwn = (b) => b.byteOffset === 0 && b.byteLength === b.buffer.byteLength ? [b.buffer] : [];
      // `me` is who this program is: a page (no arguments, no input, its output on the console), or a
      // copy of one started by `spawnSelf`, or a module started by `spawn`, whose arguments, directory and
      // streams its parent supplied.
      //
      // `wacServer` is the requests as plain JavaScript, `request` and `exit`: what every module the page runs is
      // served by (`wacServe`), its own program among them.
      const wacServer = (answer, me) => {
        const enc = new TextEncoder();
        const NONE = new Uint8Array(0);
        let rootP = null;
        // Requests withdrawn before they were answered (`OP_DROP`): what their answer would have held is closed
        // instead of handed to a program that no longer wants it.
        const dropped = new Set();
        const root = () => (rootP ??= navigator.storage.getDirectory());
        // Handles below 2 are reserved, as on every host: 0 is standard input, 1 the parent's files.
        const handles = new Map();
        // Modules loaded into this worker, by handle.
        const loaded = new Map();
        let nextLoaded = 1;
        let nextHandle = 2;
        const parts = (path) => {
          const out = [];
          const whole = String(path).startsWith("/") ? String(path) : me.cwd + "/" + String(path);
          for (const p of whole.split("/")) {
            if (p === "" || p === ".") continue;
            if (p === "..") out.pop(); else out.push(p);
          }
          return out;
        };
        const dirAt = async (ps, create) => {
          let d = await root();
          for (const p of ps) d = await d.getDirectoryHandle(p, { create });
          return d;
        };
        // The directory holding a path's last part, and that part — or a refusal for the root itself.
        const parentOf = async (path, create) => {
          const ps = parts(path);
          if (ps.length === 0) throw Object.assign(new Error("the root"), { name: "TypeMismatchError" });
          return [await dirAt(ps.slice(0, -1), create), ps[ps.length - 1]];
        };
        const faultOf = (e, isDir) => {
          switch (e?.name) {
            case "NotFoundError": return 1;
            case "NotAllowedError": case "NoModificationAllowedError": case "SecurityError": return 2;
            case "InvalidModificationError": return 4;
            case "TypeMismatchError": return isDir ? 8 : 10;
            case "QuotaExceededError": return 14;
            default: return 5;
          }
        };
        const fail = (req, e, isDir) =>
          answer(req, faultOf(e, isDir), String(e?.message ?? e), NONE, 0n, 0n, 0);
        const ok = (req, bytes = NONE, n = 0n, m = 0n, flags = 0) => answer(req, 0, "", bytes, n, m, flags);
        const run = (req, isDir, work) => { work().then((a) => a, (e) => fail(req, e, isDir)); };
        const writeTo = async (dir, name, bytes) => {
          const w = await (await dir.getFileHandle(name, { create: true })).createWritable();
          await w.write(bytes);
          await w.close();
        };
        const fileOf = async (path) => {
          const [dir, name] = await parentOf(path, false);
          return await (await dir.getFileHandle(name)).getFile();
        };
        // Standard output and error: the console for a page, the parent for a child.
        const emit = (toErr, bytes) => {
          if (me.child) me.post([toErr ? "err" : "out", bytes], wacOwn(bytes));
          else if (toErr) console.warn(new TextDecoder().decode(bytes));
          else console.log(new TextDecoder().decode(bytes));
        };
        // `OP_SPAWN`'s and `OP_SPAWN_SELF`'s bytes: the module (empty: this program), then the arguments, each
        // length-prefixed. `moduleOf` is the first part, `partsOf` the rest.
        const moduleOf = (b) => {
          const v = new DataView(b.buffer, b.byteOffset, b.byteLength);
          return b.slice(4, 4 + v.getUint32(0, true));
        };
        const partsOf = (b) => {
          const v = new DataView(b.buffer, b.byteOffset, b.byteLength);
          let at = 4 + v.getUint32(0, true);
          const n = v.getUint32(at, true);
          at += 4;
          const out = [];
          for (let i = 0; i < n; i++) {
            const len = v.getUint32(at, true);
            out.push(b.slice(at + 4, at + 4 + len));
            at += 4 + len;
          }
          return out;
        };
        // **One request at a time, by number** — design/system/0013 step 6's table, the same one every host serves.
        // What a page refuses, and in which words, `system.wac` has already decided; what reaches here is done.
        const request = (op, id, a, b, text, bytes) => {
          const n = Number(a);
          switch (op) {
            case 0: dropped.add(id); return;
            case 1: return ok(id, NONE, BigInt(Date.now()));
            case 2: return ok(id, NONE, BigInt(Math.round(performance.now() * 1e6)));
            case 3: return ok(id, crypto.getRandomValues(new Uint8Array(n)));
            case 6: return ok(id, NONE, BigInt(me.args.length));
            case 7: return ok(id, me.args[n] ?? NONE);
            case 41: return answer(id, 0, me.cwd, NONE, 0n, 0n, 0);
            case 9: return run(id, true, async () => ok(id, new Uint8Array(await (await fileOf(text)).arrayBuffer())));
            case 10: return run(id, true, async () => {
              const [dir, name] = await parentOf(text, false);
              await writeTo(dir, name, bytes);
              ok(id);
            });
            // No links in the Origin Private File System, so a stat and a link stat are one question.
            case 13: case 47: return run(id, false, async () => {
              try {
                const f = await fileOf(text);
                return ok(id, NONE, BigInt(f.size), BigInt(f.lastModified), 1 | 2);
              } catch (e) {
                if (e?.name !== "TypeMismatchError" && e?.name !== "NotFoundError") throw e;
              }
              try {
                await dirAt(parts(text), false);
                return ok(id, NONE, 0n, 0n, 1 | 4);
              } catch (e) {
                if (e?.name !== "TypeMismatchError" && e?.name !== "NotFoundError") throw e;
              }
              ok(id);
            });
            case 14: return run(id, false, async () => {
              const d = await dirAt(parts(text), false);
              const names = [];
              for await (const k of d.keys()) names.push(k);
              ok(id, enc.encode(names.sort().map((x) => x + String.fromCharCode(0)).join("")), 0n, 0n, 1);
            });
            case 15: return run(id, false, async () => {
              const parentsToo = n !== 0;
              const [dir, name] = await parentOf(text, parentsToo);
              if (!parentsToo) {
                let there = true;
                try { await dir.getDirectoryHandle(name); } catch { there = false; }
                if (there) return answer(id, 3, "", NONE, 0n, 0n, 0);
              }
              await dir.getDirectoryHandle(name, { create: true });
              ok(id);
            });
            case 16: return run(id, false, async () => {
              const [dir, name] = await parentOf(text, false);
              await dir.removeEntry(name, { recursive: n !== 0 });
              ok(id);
            });
            // No rename in the Origin Private File System: a copy and a delete, which is not atomic.
            case 17: return run(id, true, async () => {
              const to = new TextDecoder().decode(bytes);
              const content = new Uint8Array(await (await fileOf(text)).arrayBuffer());
              const [dir, name] = await parentOf(to, false);
              await writeTo(dir, name, content);
              const [fdir, fname] = await parentOf(text, false);
              await fdir.removeEntry(fname);
              ok(id);
            });
            case 12: case 48: emit(op === 48, bytes); return ok(id, NONE, 0n, 0n, 1);
            case 19: return read(id, me.stdin);
            case 30: setTimeout(() => ok(id, NONE, BigInt(Math.round(performance.now() * 1e6))), n); return;
            case 27: return spawn(id, partsOf(bytes), n, text, Number(b), moduleOf(bytes));
            case 24: return read(id, n === 1 && me.served ? me.fsIn : handles.get(n)?.q);
            case 25: {
              const to = handles.get(n);
              // The line to a parent exists only when the parent serves this child files: anything else is a
              // send that did not go, as on every other host, so a child that asks is told at once.
              if (n === 1 && me.served) me.post(["fs", bytes], wacOwn(bytes));
              else if (to !== undefined && to.kind === "write") {
                return to.w.write(bytes).then(() => ok(id, NONE, 0n, 0n, 1), () => answer(id, 5, "", NONE, 0n, 0n, 0));
              }
              else if (to === undefined || to.child === undefined || to.child.gone) return answer(id, 5, "", NONE, 0n, 0n, 0);
              else if (to.kind === "out") to.child.send(["stdin", bytes], wacOwn(bytes));
              else if (to.kind === "fs") to.child.send(["fs", bytes], wacOwn(bytes));
              return ok(id, NONE, 0n, 0n, 1);
            }
            case 29: { const c = handles.get(n)?.child; if (c && !c.gone) c.send(["stdinEnd"]); return; }
            case 26: { const to = handles.get(n); if (to && to.kind === "out") stop(to.child, 143); return; }
            case 28: {
              const c = handles.get(n)?.child;
              if (c === undefined) return answer(id, 5, "not a child", NONE, 0n, 0n, 0);
              c.exit.then((code) => ok(id, NONE, BigInt(code)));
              return;
            }
            // A file as a handle of its own. A read takes the whole file at once and queues it in pieces, so
            // `recv` serves it as it serves a child; a write goes to the browser's writable stream, which keeps
            // nothing until it is closed — so a file half-written by a program that stopped is not left behind.
            case 61: return run(id, true, async () => {
              let held;
              if (n === 0) {
                const content = new Uint8Array(await (await fileOf(text)).arrayBuffer());
                const q = wacQueue();
                for (let at = 0; at < content.length; at += 65536) q.push(content.slice(at, at + 65536));
                q.end();
                held = { kind: "file", q };
              } else {
                const [dir, name] = await parentOf(text, false);
                const fh = await dir.getFileHandle(name, { create: true });
                const w = await fh.createWritable({ keepExistingData: n === 2 });
                if (n === 2) await w.seek((await fh.getFile()).size);
                held = { kind: "write", w };
              }
              if (dropped.delete(id)) { if (held.kind === "write") await held.w.abort(); return; }
              const h = nextHandle++;
              handles.set(h, held);
              ok(id, NONE, BigInt(h));
            });
            case 62: {
              const f = handles.get(n);
              if (f === undefined || (f.kind !== "file" && f.kind !== "write")) return answer(id, 5, "", NONE, 0n, 0n, 0);
              handles.delete(n);
              if (f.kind === "file") return ok(id, NONE, 0n, 0n, 1);
              f.w.close().then(() => ok(id, NONE, 0n, 0n, 1), (e) => fail(id, e, true));
              return;
            }
            // **A module in this worker, called by name** (`wacLoad`) — how `wac test` runs tests. Answered at once, as
            // on every host; what it holds was narrowed before it got here.
            case 67: { const why = wacNotRunnable(bytes); return answer(id, why === "" ? 0 : 5, why, NONE, 0n, 0n, 0); }
            case 64: {
              const why = wacNotRunnable(bytes);
              if (why !== "") return answer(id, 5, why, NONE, 0n, 0n, 0);
              const h = nextLoaded++;
              loaded.set(h, wacLoad(me, bytes.slice(), n));
              return ok(id, NONE, BigInt(h));
            }
            case 65: {
              const m = loaded.get(n);
              if (m === undefined) return answer(id, 0, "no module loaded as " + n, NONE, 0n, 0n, 2);
              const [status, said, value] = m.call(text, Number(b));
              return answer(id, 0, said, NONE, BigInt(value), 0n, status);
            }
            case 66: loaded.delete(n); return;
            case 68: return answer(id, 9, "no capability " + text + " in a page", NONE, 0n, 0n, 0);
            default: return answer(id, 9, "a page does not serve request " + op, NONE, 0n, 0n, 0);
          }
        };
        return { request, exit: (code) => {
          if (!me.child) throw new Error("the program exited with " + code);
          me.post(["exit", code]);
          close();
        } };

        // ── Programs started from this one ───────────────────────────────────────────────────────
        // A child is a worker on this very script, told who it is by its first message. Its output,
        // its errors and its questions about files arrive as messages and wait in queues until read;
        // its input and the answers to its questions go back the same way.
        function read(req, q) {
          if (q === undefined) return answer(req, 0, "", NONE, 0n, 0n, 1);
          q.next().then((r) => r.end ? answer(req, 0, "", NONE, 0n, 0n, 1) : answer(req, 0, "", r.bytes, 0n, 0n, 0));
        }
        // Only the page's thread, which started the child, can end it: asked to, it stops the child and whatever the
        // child started.
        function stop(c, code) {
          if (c.gone) return;
          c.gone = true;
          if (c.id >= 0) { wacTellPage(["stop", c.id]); wacChildFailed.delete(c.id); }
          c.port?.close();
          c.out.end(); c.err.end(); c.fs.end();
          c.settle(code);
        }
        // `wasm` is a module to run (`OP_SPAWN`), or null for another copy of this page (`OP_SPAWN_SELF`). Either
        // way the child is a worker on this very script; its first message says which it is.
        // `flags` is `Launch`'s: 1 the child reads this program's input, 2 it writes this program's output and
        // errors, and 256 this program serves it files.
        function spawn(req, args, grants, cwd, flags, wasm) {
          const serveFs = (flags & 256) !== 0, inheritIn = (flags & 1) !== 0, inheritOut = (flags & 2) !== 0;
          if (typeof WorkerGlobalScope === "undefined") {
            return answer(req, 9, "a page built --in-page cannot start programs", NONE, 0n, 0n, 0);
          }
          // **A module is checked before anything starts**, as the other hosts check one: a file that is not a wac
          // program is refused here, at `spawn`, rather than started in a worker that then fails to compile it.
          if (wasm !== null) {
            const why = wacNotRunnable(wasm);
            if (why !== "") return answer(req, 5, why, NONE, 0n, 0n, 0);
          }
          // **The page's own thread starts it** (design/system/0015 decision 3), and hands this program one end of a
          // channel and the child the other: they talk directly, and the page is involved only to start and to stop.
          // A page opened from a file may not start a worker from a worker, and its own thread may — so this is one
          // route on `http://` and `file://` alike.
          let settle;
          const c = { id: -1, port: null, waiting: [], out: wacQueue(), err: wacQueue(), fs: wacQueue(), gone: false,
                      exit: new Promise((r) => { settle = r; }) };
          c.settle = settle;
          // What this program sends before the channel arrives waits for it.
          c.send = (m, transfer) => { if (c.port !== null) c.port.postMessage(m, transfer ?? []); else c.waiting.push([m, transfer]); };
          const h = nextHandle++, eh = nextHandle++, fh = serveFs ? nextHandle++ : -1;
          handles.set(h, { kind: "out", child: c, q: c.out });
          handles.set(eh, { kind: "err", child: c, q: c.err });
          if (fh >= 0) handles.set(fh, { kind: "fs", child: c, q: c.fs });
          // **Inherited output is written as it arrives**, to this program's own streams, which keeps the order
          // between the two; the child's queues are left empty, and end when it does.
          const heard = (e) => {
            const [k, v] = e.data;
            if (k === "out") { if (inheritOut) emit(false, v); else c.out.push(v); }
            else if (k === "err") { if (inheritOut) emit(true, v); else c.err.push(v); }
            else if (k === "fs") c.fs.push(v);
            else if (k === "exit") stop(c, v);
          };
          // **Inherited input is read for the child while it runs** — from this program's input, which a page has
          // none of — and a piece read after it ended goes back for whoever reads next.
          if (inheritIn && me.stdin !== undefined) {
            (async () => {
              while (!c.gone) {
                const r = await me.stdin.next();
                if (c.gone) { if (!r.end) me.stdin.unshift(r.bytes); return; }
                if (r.end) { c.send(["stdinEnd"]); return; }
                c.send(["stdin", r.bytes]);
              }
            })();
          }
          wacAskPage(["start", "module", { wasm, args, grants, cwd, serveFs }], wacOwn(wasm)).then(([id, port, why]) => {
            if (port === null) {
              if (dropped.delete(req)) return;
              return answer(req, 5, "the program could not be started: " + why, NONE, 0n, 0n, 0);
            }
            c.id = id;
            c.port = port;
            port.onmessage = heard;
            // A child that dies without saying so — a trap the browser reports, not an exit — is heard of from the
            // page's thread, which saw it.
            wacChildFailed.set(id, (why) => {
              c.err.push(enc.encode((why || "the program stopped") + "\\n"));
              stop(c, 134);
            });
            for (const [m, t] of c.waiting) port.postMessage(m, t ?? []);
            c.waiting = [];
            if (dropped.delete(req)) return stop(c, 143);
            // `m` packs the error stream's handle (low 32 bits) and the served-files channel's (high 32).
            ok(req, NONE, BigInt(h), (BigInt(eh) & 0xffffffffn) | (BigInt(fh) << 32n));
          });
        }
      };
      """;
}

/**
 * A module the page was handed, run in a worker of its own (design/system/0015): `OP_SPAWN`'s other half.
 *
 * **Driven from its manifest**, as wac's `packages/platform/host/driver.ts` drives one on Deno and Node: the module
 * describes its own boundary in a `wac.manifest` section, and since design/system/0013 step 6 that boundary is a
 * handful of plain values — `__wacHost` takes the host's four calls, `__wacAnswered` takes an answer, and the rest
 * are opaque references handed straight back. So the conversions are strings, arrays and functions, and they are
 * `marshal.ts`'s, written again here because a page carries no TypeScript.
 *
 * **Its requests are served by `wacServer`**, the same switch that serves the page's own program and a copy of the
 * page — one implementation of what a request means in a browser.
 *
 * **It never blocks.** Its `waitAny` answers `HOST_CANNOT_WAIT` (-2); an `async` program then hands control back,
 * and is run on with `__wacAdvance` once an answer has arrived. An answer the browser has at once — the clock, an
 * argument, a write to a stream — is delivered inside the request that asked, as on every host; anything else is
 * delivered between turns, when the module is running nothing. A program whose `main` is not `async` blocks on its
 * first wait for the browser, and stops saying so.
 *
 * **It holds what it was handed and no more**: the browser half decides nothing, so what a page's own program has
 * refused for it by `system.wac`, a module has refused for it here (`wacServe`). And it may `load` a module into
 * its own worker and call it by name (`wacLoad`), answered at once as on every host — which is how `wac test`
 * runs tests.
 */
export string moduleSide() {
  return """
      // ── A module, driven from its manifest: `marshal.ts`'s conversions, by the shape of a type string. ──────
      const wacDrive = (mod, manifest) => {
        let ex = null;
        const call = (name, ...a) => {
          if (typeof ex[name] !== "function") throw new Error("the module exports no " + name);
          return ex[name](...a);
        };
        const mem = () => new Uint8Array(ex["$bind$mem"].buffer);
        const SCALARS = new Set(["i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "f32", "f64", "bool"]);
        const bindName = (n) => n.replace(/[^A-Za-z0-9_]+/g, "$").replace(/^[$]+|[$]+$/g, "");
        const shapeOf = (type) => {
          const t = type.trim();
          if (t.endsWith("?")) return shapeOf(t.slice(0, -1));
          if (t === "void" || t === "") return { kind: "void" };
          if (t === "string") return { kind: "string" };
          if (SCALARS.has(t)) return { kind: "scalar", name: t };
          if (t.endsWith("[]")) {
            const elem = shapeOf(t.slice(0, -2));
            const suffix = elem.kind === "scalar" ? elem.name : elem.kind === "string" ? "string"
              : elem.kind === "array" ? elem.suffix + "Arr" : bindName(elem.name ?? "void");
            return { kind: "array", elem, suffix };
          }
          return { kind: "ref", name: t };
        };
        const give = (make, data) => {
          call("$bind$mem_ensure", data.length);
          mem().set(data, 0);
          return call(make, data.length);
        };
        const fromWasm = (sh, w) => {
          if (w === null || w === undefined) return null;
          switch (sh.kind) {
            case "void": return undefined;
            case "scalar": return sh.name === "bool" ? w !== 0 : w;
            case "ref": return w;
            case "string": {
              const n = call("$bind$str_len", w);
              call("$bind$mem_ensure", n);
              call("$bind$str_to_mem", w);
              return new TextDecoder().decode(mem().slice(0, n));
            }
            case "array": {
              if (sh.elem.kind === "scalar" && sh.elem.name === "u8") {
                const n = call("$bind$arr_u8_len", w);
                call("$bind$mem_ensure", n);
                call("$bind$arr_u8_to_mem", w);
                return mem().slice(0, n);
              }
              const n = call("$bind$arr_" + sh.suffix + "_len", w);
              const out = [];
              for (let i = 0; i < n; i++) out.push(fromWasm(sh.elem, call("$bind$arr_" + sh.suffix + "_get", w, i)));
              return out;
            }
          }
        };
        // A function becomes a funcref, made by the module from a slot — the one conversion a host cannot do.
        const slots = manifest.callbacks.map(() => []);
        const toWasm = (type, v) => {
          const base = type.endsWith("?") ? type.slice(0, -1) : type;
          if (base.startsWith("fn[") && typeof v === "function") {
            const j = manifest.callbacks.findIndex((c) => c.type === base);
            if (j < 0) throw new Error(base + " has no dispatcher in this module");
            let slot = slots[j].indexOf(v);
            if (slot < 0) { slot = slots[j].length; slots[j].push(v); }
            return call(manifest.callbacks[j].helper, slot);
          }
          const sh = shapeOf(base);
          if (v === null || v === undefined) return sh.kind === "void" ? undefined : null;
          switch (sh.kind) {
            case "void": return undefined;
            case "scalar": return sh.name === "bool" ? (v ? 1 : 0) : v;
            case "ref": return v;
            case "string": return give("$bind$str_from_mem", new TextEncoder().encode(String(v)));
            case "array": {
              if (sh.elem.kind === "scalar" && sh.elem.name === "u8") return give("$bind$arr_u8_from_mem", Uint8Array.from(v));
              const elem = base.slice(0, -2);
              const filled = typeof ex["$bind$arr_" + sh.suffix + "_new0"] === "function";
              if (filled && v.length === 0) return call("$bind$arr_" + sh.suffix + "_new0");
              const arr = filled ? call("$bind$arr_" + sh.suffix + "_new", v.length, toWasm(elem, v[0]))
                                 : call("$bind$arr_" + sh.suffix + "_new", v.length);
              for (let i = filled ? 1 : 0; i < v.length; i++) call("$bind$arr_" + sh.suffix + "_set", arr, i, toWasm(elem, v[i]));
              return arr;
            }
          }
        };
        const wac = {};
        manifest.callbacks.forEach((cb, j) => {
          wac[cb.field] = (slot, ...rest) => {
            const f = slots[j][slot];
            if (f === undefined) throw new Error("no function in slot " + slot + " of " + cb.type);
            const out = f(...(cb.params ?? []).map((t, i) => fromWasm(shapeOf(t), rest[i])));
            return cb.ret === "void" ? undefined : toWasm(cb.ret, out);
          };
        });
        ex = new WebAssembly.Instance(mod, { wac }).exports;
        const app = {};
        for (const sig of manifest.exports) {
          if (typeof ex[sig.name] !== "function") continue;
          app[sig.name] = (...a) => {
            const out = ex[sig.name](...sig.params.map((t, i) => toWasm(t, a[i])));
            return sig.ret === "" || sig.ret === "void" ? undefined : fromWasm(shapeOf(sig.ret), out);
          };
        }
        // What `trap "…"` left behind, or "" — asked of a module that has just trapped, so it may trap itself.
        const trapSaid = () => {
          try { return typeof ex["$trap$message"] === "function" ? fromWasm({ kind: "string" }, ex["$trap$message"]()) ?? "" : ""; }
          catch { return ""; }
        };
        return { app, manifest, trapSaid };
      };
      const wacManifestOf = (mod) => {
        const section = WebAssembly.Module.customSections(mod, "wac.manifest");
        return section.length === 0 ? null : JSON.parse(new TextDecoder().decode(section[0]));
      };

      // ── Serving a module: one `wacServer` per module, so each keeps its own requests and handles. ────────────
      //
      // `wasm` is the module's bytes, for its `spawnSelf`; `grants` is what it was handed; `deliver` gives it an
      // answer. **What it was not handed is refused here**, as `system.wac`'s `refusal` refuses what the page was
      // not built with: its requests come straight to `wacServer`, which does what it is asked and decides nothing.
      // Files need `GRANT_READ` (1) to look and `GRANT_WRITE` (2) to change, and what it starts or loads holds no
      // more than it does. A program with no files of its own is served its parent's over handle 1, and asks
      // nothing here. Answers the browser has at once — the clock, randomness, an argument, the directory, a write
      // to a stream, and the module calls — are delivered inside the request that asked; the rest when `later`
      // says, which is between turns, when the module is running nothing.
      const AT_ONCE = new Set([1, 2, 3, 6, 7, 41, 12, 48, 64, 65, 66, 67]);
      const wacServe = (me, wasm, grants, deliver, later) => {
        const NONE = new Uint8Array(0);
        let asking = -1;
        const answer = (...a) => {
          if (asking >= 0 && AT_ONCE.has(asking)) deliver(a);
          else later(a);
        };
        const server = wacServer(answer, me);
        const looks = (op, a) => op === 9 || op === 13 || op === 47 || op === 14 || (op === 61 && Number(a) === 0);
        const changes = (op) => op === 10 || op === 15 || op === 16 || op === 17 || op === 61 || op === 52 || op === 60;
        // The page's own program was granted what the build said; anything else, what the program that started it handed it.
        const notHanded = (what) => "Not granted to this application: " + (me.child
          ? "the program that started it did not hand it `" + what + "`" : "the page was built without `--grant " + what + "`");
        const ok = (id) => answer(id, 0, "", NONE, 0n, 0n, 0);
        const request = (op, id, a, b, text, bytes) => {
          const was = asking;
          asking = op;
          try {
            if (looks(op, a) && (grants & 1) === 0) return answer(id, 7, notHanded("read"), NONE, 0n, 0n, 0);
            if (!looks(op, a) && changes(op) && (grants & 2) === 0) return answer(id, 7, notHanded("write"), NONE, 0n, 0n, 0);
            // No environment and no standard input to read whole, as for the page's own program.
            if (op === 8 || op === 11) return ok(id);
            if (op === 27) return server.request(op, id, BigInt(Number(a) & grants), b, text, bytes);
            // **Itself again is this module again**, not a copy of the page whose script the worker runs on.
            if (op === 49) {
              const v = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
              const rest = bytes.slice(4 + v.getUint32(0, true));
              const whole = new Uint8Array(4 + wasm.length + rest.length);
              new DataView(whole.buffer).setUint32(0, wasm.length, true);
              whole.set(wasm, 4);
              whole.set(rest, 4 + wasm.length);
              return server.request(27, id, BigInt(Number(a) & grants), b, text, whole);
            }
            if (op === 64) return server.request(op, id, BigInt(Number(a) & grants), b, text, bytes);
            server.request(op, id, a, b, text, bytes);
          } finally { asking = was; }
        };
        return { request, exit: server.exit };
      };

      // A module loaded into this worker: driven, given a host of its own, and called by name — the native host's
      // `call_loaded`. An export taking nothing, an `i32` or its `Host`, and answering nothing, an `i32` or a
      // `string`: status 0 with the answer, 1 for a trap with what it said, 2 for no such export, 3 for one this
      // cannot call.
      const wacLoad = (me, wasm, grants) => {
        const mod = new WebAssembly.Module(wasm);
        const d = wacDrive(mod, wacManifestOf(mod));
        let host = null;
        const deliver = (a) => d.app.__wacAnswered(host, ...a);
        const s = wacServe(me, wasm, grants, deliver, (a) => setTimeout(() => deliver(a), 0));
        if (typeof d.app.__wacHost === "function") {
          host = d.app.__wacHost(s.request, (ids, millis) => -2, (code) => { throw new Error("exited with " + code); }, () => false);
        }
        return {
          call(name, arg) {
            const sig = d.manifest.exports.find((e) => e.name === name);
            if (sig === undefined || typeof d.app[name] !== "function") return [2, "no export named " + name, 0];
            const takesInt = sig.params.length === 1 && sig.params[0] === "i32";
            // The host value is whatever this module's `__wacHost` answers: `Host`, or `Host__std` beside another `Host`.
            const hostType = (d.manifest.exports.find((e) => e.name === "__wacHost") || {}).ret;
            const takesHost = sig.params.length === 1 && sig.params[0] === hostType;
            if (sig.params.length > 0 && !takesInt && !takesHost) return [3, "cannot call " + name + "(" + sig.params.join(", ") + ")", 0];
            if (takesHost && host === null) return [3, name + " takes a Host and this module exports no __wacHost", 0];
            const ret = sig.ret === "" ? "void" : sig.ret;
            if (ret !== "void" && ret !== "i32" && ret !== "string") return [3, name + " answers " + ret, 0];
            let out;
            try { out = d.app[name](...(takesInt ? [arg] : takesHost ? [host] : [])); }
            catch { return [1, d.trapSaid(), 0]; }
            return ret === "string" ? [0, out ?? "", 0] : [0, "", ret === "i32" ? out : 0];
          },
        };
      };

      // ── A module, run: driven from its manifest, served by `wacServe`, and run on as answers arrive. ───────────
      //
      // `layered`, when given, stands between the module and `wacServe`: it is handed the server's `request` and an
      // `answer` for its own answers — delivered at once inside a request, and between turns otherwise, as the
      // server's are — and answers the `request` the module makes. The page's program runs under `wac.page` that way.
      // `said` is where a module that cannot run says why. Answers whatever the layer answered.
      const wacRun = (wasm, me, grants, layered, said) => {
        const mod = new WebAssembly.Module(wasm);
        const manifest = wacManifestOf(mod);
        if (manifest === null) {
          said("this is not a wac program: it carries no wac.manifest section");
          return null;
        }
        const { app } = wacDrive(mod, manifest);
        let host = null, run = null, finished = false, turning = false, depth = 0;
        const arrived = [];
        const deliver = (a) => { if (!finished) app.__wacAnswered(host, ...a); };
        const turn = () => {
          turning = false;
          if (finished) return;
          while (arrived.length > 0) deliver(arrived.shift());
          if (run === null) return;
          run = app.__wacAdvance(run);
          settle();
        };
        const later = (a) => {
          if (finished) return;
          arrived.push(a);
          if (!turning) { turning = true; setTimeout(turn, 0); }
        };
        const s = wacServe(me, wasm, grants, deliver, later);
        const top = layered ? layered(s.request, (...a) => depth > 0 ? deliver(a) : later(a)) : { request: s.request };
        const request = (...r) => {
          depth++;
          try { return top.request(...r); } finally { depth--; }
        };
        const settle = () => {
          if (finished || run === null || !app.__wacDone(run)) return;
          finished = true;
          s.exit(app.__wacStatus(run));
        };
        // A page cannot wait: `HOST_CANNOT_WAIT`, and an `async` program yields.
        const waitAny = (ids, millis) => -2;
        const exitWith = (code) => {
          finished = true;
          s.exit(code);
          throw new Error("exited");
        };
        const interrupted = () => false;
        try {
          // **A program that takes nothing has no host**: its `main` has no parameter and the module exports no
          // `__wacHost`, so there is nothing to make and nothing it will ask.
          if (typeof app.__wacHost === "function") host = app.__wacHost(request, waitAny, exitWith, interrupted);
          if (typeof app.__wacStart === "function") {
            run = app.__wacStart(host);
            settle();
          } else {
            const sig = manifest.exports.find((e) => e.name === "main");
            if (sig === undefined) throw new Error("the module has no main");
            const code = app.main(...(sig.params.length > 0 ? [host] : []));
            finished = true;
            s.exit(code ?? 0);
          }
        } catch (e) {
          if (!finished) {
            said(String(e?.message ?? e));
            finished = true;
            s.exit(134);
          }
        }
        return top;
      };

      // ── A module the page was handed, as a process: `OP_SPAWN`'s other half. ─────────────────────────────────
      const wacModule = (init, port) => {
        const stdin = wacQueue(), fsIn = wacQueue();
        const me = { child: true, served: !!init.serveFs, args: init.args, cwd: init.cwd || "/", stdin, fsIn,
                     post: (m, transfer) => port.postMessage(m, transfer ?? []) };
        port.onmessage = (e) => wacFromParent(e.data, stdin, fsIn);
        const said = (text) => me.post(["err", new TextEncoder().encode(text + String.fromCharCode(10))]);
        if (wacRun(init.wasm, me, Number(init.grants), null, said) === null) {
          me.post(["exit", 126]);
          close();
        }
      };

      // ── The page's own program: a module like any other, under `wac.page`. ─────────────────────────────────────
      //
      // It holds what the build granted (`grants`), draws by sending `post` what the document applies, starts at
      // location `where`, and answers `receive` for what the document sends back.
      const wacPage = (wasm, grants, post, where, site) => {
        const me = { child: false, args: [], cwd: "/", post: null };
        const top = wacRun(wasm, me, grants, (next, answer) => wacPageServer(next, answer, post, where, site), (text) => console.error(text));
        return top === null ? () => {} : top.receive;
      };
      """;
}

/**
 * The document's half: each message from the program applied to the document, and each event, frame
 * and file sent back with `emit`. No decisions are made here — everything a page does is in
 * `src/page.wac`, where it is tested without a browser.
 *
 * **Every answer is sent later, never during the call that asked.** On the page the two halves are
 * joined directly, so an answer sent at once would run the program inside the call that asked.
 */
export string documentSide() {
  return """
      const wacDocument = (root, emit) => {
        // **The handles**: each number the program chose, and the node it named. 0 is the root.
        const nodes = new Map([[0, root]]);
        const handleOf = new WeakMap([[root, 0]]);
        // Events are numbered, and an input remembers the number of the last one typed into it — a value
        // the program sends without having seen that event is older than what the user typed, and dropped.
        let seq = 0;
        const numbered = (ev) => (ev.__wacSeq ??= ++seq);
        // **Where an event began**, inside a shadow root too: `target` is retargeted to the shadow root's host for a
        // listener outside it, and the text field typed into is the one that matters (`Element.shadow`).
        const origin = (ev) => (ev.composedPath ? ev.composedPath()[0] : ev.target) ?? ev.target;
        root.addEventListener("input", (ev) => { origin(ev).__wacTyped = numbered(ev); }, true);
        const place = (parent, n, before) => {
          const p = nodes.get(parent);
          if (p) p.insertBefore(n, before < 0 ? null : (nodes.get(before) ?? null));
        };
        const forget = (n) => {
          if (handleOf.has(n)) nodes.delete(handleOf.get(n));
          for (const k of n.childNodes ?? []) forget(k);
        };
        const blit = (ctx, w, h, rgba, x, y) => {
          const img = ctx.createImageData(w, h);
          img.data.set(rgba);
          ctx.putImageData(img, x, y);
        };
        // Where in the element the pointer is, in the element's own pixels: a canvas's backing store
        // rather than its size on screen, so a scaled canvas still answers in the units it is drawn in.
        const within = (el, ev) => {
          // A shadow root has no box of its own: its host's is where it is drawn.
          if (!el.getBoundingClientRect && el.host) el = el.host;
          if (ev.clientX === undefined || !el.getBoundingClientRect) return [0, 0];
          const r = el.getBoundingClientRect();
          const sx = el.width !== undefined && r.width > 0 ? el.width / r.width : 1;
          const sy = el.height !== undefined && r.height > 0 ? el.height / r.height : 1;
          return [Math.round((ev.clientX - r.left) * sx), Math.round((ev.clientY - r.top) * sy)];
        };
        const ops = {
          make: (id, parent, tag, before) => {
            // `#shadow` is the parent's shadow root, opened — a page of its own inside it (`Element.shadow`).
            if (tag === "#shadow") {
              const host = nodes.get(parent);
              if (!host || !host.attachShadow) return;
              const sr = host.shadowRoot ?? host.attachShadow({ mode: "open" });
              // `input` crosses the shadow root's edge to the listener on the root; `change` does not, so a file
              // chosen in there is heard here.
              sr.addEventListener("change", (ev) => changed(ev));
              nodes.set(id, sr); handleOf.set(sr, id);
              return;
            }
            const el = document.createElement(tag);
            nodes.set(id, el); handleOf.set(el, id); place(parent, el, before);
          },
          makeText: (id, parent, text, before) => {
            const t = document.createTextNode(text);
            nodes.set(id, t); handleOf.set(t, id); place(parent, t, before);
          },
          text: (id, text) => {
            const n = nodes.get(id);
            if (!n) return;
            if (n.nodeType === 3) { n.data = text; return; }
            for (const k of n.childNodes) forget(k);
            n.textContent = text;
          },
          attr: (id, name, value, present) => {
            const n = nodes.get(id);
            if (n && n.setAttribute) { if (present) n.setAttribute(name, value); else n.removeAttribute(name); }
          },
          prop: (id, name, value, seen) => {
            const n = nodes.get(id);
            if (!n) return;
            if (name === "value") {
              if ((n.__wacTyped ?? 0) > seen) return;
              if (n.value !== value) n.value = value;
            } else n[name] = value === "true";
          },
          select: (id, start, end, seen) => {
            const n = nodes.get(id);
            if (!n || !n.setSelectionRange || (n.__wacTyped ?? 0) > seen) return;
            n.setSelectionRange(start, end);
          },
          // **As if typed**, so the edit is undoable and an `input` event follows: `execCommand` acts on the
          // focused field, so focus it first; `setRangeText`, which is not undoable, where a browser has
          // dropped `execCommand`.
          typeText: (id, text, seen) => {
            const n = nodes.get(id);
            if (!n || (n.__wacTyped ?? 0) > seen) return;
            const active = n.getRootNode ? n.getRootNode().activeElement : document.activeElement;
            if (n !== active && n.focus) n.focus();
            if (document.execCommand && document.execCommand("insertText", false, text)) return;
            if (!n.setRangeText) return;
            n.setRangeText(text, n.selectionStart, n.selectionEnd, "end");
            n.dispatchEvent(new Event("input", { bubbles: true }));
          },
          move: (id, before) => {
            const n = nodes.get(id);
            if (n && n.parentNode) n.parentNode.insertBefore(n, before < 0 ? null : (nodes.get(before) ?? null));
          },
          remove: (id) => {
            const n = nodes.get(id);
            if (!n) return;
            forget(n);
            n.remove();
          },
          listenOn: (id, kind, prevent) => {
            const n = nodes.get(id);
            if (!n) return;
            // `prevent` names keys: `Tab` matches with any modifiers held, and `Ctrl+s` only with exactly
            // Ctrl (of Ctrl, Alt, Shift and Meta) — so a page can take Ctrl+S without taking every `s`. A
            // single letter matches either case, since Shift turns `s` into `S`.
            const keys = prevent === "" || prevent === "*" ? [] : prevent.split(" ").filter((k) => k !== "").map((k) => {
              const parts = k.split("+");
              if (parts.length === 1 || k === "+") return { key: k, mods: -1 };
              const bit = { Shift: 1, Ctrl: 2, Alt: 4, Meta: 8 };
              let mods = 0;
              for (const p of parts.slice(0, -1)) mods |= bit[p] ?? 0;
              return { key: parts[parts.length - 1], mods };
            });
            const keyMatches = (ev) => keys.some((k) => {
              const held = (ev.shiftKey ? 1 : 0) | (ev.ctrlKey ? 2 : 0) | (ev.altKey ? 4 : 0) | (ev.metaKey ? 8 : 0);
              if (k.mods >= 0 && k.mods !== held) return false;
              return k.key.length === 1 ? k.key.toLowerCase() === ev.key.toLowerCase() : k.key === ev.key;
            });
            n.addEventListener(kind, (ev) => {
              let t = ev.target;
              // Inside a shadow root, `parentNode` stops at the root, whose host is the next node out.
              while (t && t !== n && !handleOf.has(t)) t = t.parentNode ?? t.host;
              if (!t || !handleOf.has(t)) return;
              const keyed = kind === "keydown" || kind === "keyup";
              if (prevent === "*" || kind === "submit" || (keyed && keyMatches(ev))) ev.preventDefault();
              const el = ev.target;
              const value = keyed ? ev.key : (el && "value" in el ? String(el.value) : "");
              // In the listening element's own pixels, whatever is under the pointer inside it: a bar's
              // handler gets the bar's coordinates over its title, and a desktop's the desktop's over a window.
              const [x, y] = within(n, ev);
              const mods = (ev.shiftKey ? 1 : 0) | (ev.ctrlKey ? 2 : 0) | (ev.altKey ? 4 : 0) | (ev.metaKey ? 8 : 0);
              // The caret of the text field it happened in; -1 where there is none.
              const caret = el && typeof el.selectionStart === "number";
              emit(["el", numbered(ev), kind, handleOf.get(t), id, value, x, y, mods,
                    caret ? el.selectionStart : -1, caret ? el.selectionEnd : -1]);
            });
          },
          focus: (id) => { const n = nodes.get(id); if (n && n.focus) n.focus(); },
          // A handle's canvas, which `Element.pixels` has already checked is one.
          pixels: (id, w, h, rgba) => {
            const el = nodes.get(id);
            if (!el) return;
            // Resizing clears a canvas, so only when the size changes.
            if (el.width !== w) el.width = w;
            if (el.height !== h) el.height = h;
            blit(el.getContext("2d"), w, h, rgba, 0, 0);
          },
          pixelsIn: (id, x, y, w, h, rgba) => { const el = nodes.get(id); if (el) blit(el.getContext("2d"), w, h, rgba, x, y); },
          // Under the handle's own element only: a name reaches no further than the handle does.
          scroll: (id, named) => {
            const n = nodes.get(id);
            const el = !n || named === "" ? n : [...n.querySelectorAll("[id]")].find((e) => e.id === named);
            if (el && el.scrollIntoView) el.scrollIntoView({ block: "start" });
          },
          valueOf: (req, id) => {
            const n = nodes.get(id);
            const value = n && "value" in n ? String(n.value) : "";
            queueMicrotask(() => emit(["value", req, value]));
          },
          title: (title) => { document.title = title; },
          frame: (id) => { requestAnimationFrame(() => emit(["timer", id])); },
          download: (name, bytes) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(new Blob([bytes]));
            a.download = name;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
          },
        };
        // Files arrive whether or not the program has asked yet; the page keeps them until it does.
        // A file's name is its path below what the user handed over — `photos/2024/a.jpg` for a file
        // in a folder, picked with `webkitdirectory` or dropped, and `a.jpg` for a file on its own.
        const send = (f, path) => f.arrayBuffer().then(
          (buf) => emit(["file", true, path, new Uint8Array(buf), ""], [buf]),
          (e) => emit(["file", false, path, new Uint8Array(0), String(e?.message ?? e)]));
        const take = (files) => { for (const f of files ?? []) send(f, f.webkitRelativePath || f.name); };
        // A dropped folder is a directory entry rather than a file — reading it as one fails — so it is
        // walked. `readEntries` answers in batches, and an empty batch is the end of the directory.
        const rel = (p) => p.startsWith("/") ? p.slice(1) : p;
        const failed = (path, e) => emit(["file", false, path, new Uint8Array(0), String(e?.message ?? e)]);
        const walk = (entry) => {
          if (entry.isFile) {
            entry.file((f) => send(f, rel(entry.fullPath)), (e) => failed(rel(entry.fullPath), e));
          } else if (entry.isDirectory) {
            // Some browsers refuse to list a dropped folder on a page opened from a `file://` URL: the
            // error says it was a folder, so a program can say what to do instead.
            const reader = entry.createReader();
            const more = () => reader.readEntries(
              (batch) => { if (batch.length > 0) { batch.forEach(walk); more(); } },
              (e) => failed(rel(entry.fullPath), `a dropped folder could not be listed here (${e?.name}: ${e?.message})`));
            more();
          }
        };
        // **A handle where the browser has one** (Chrome, Edge): the entry API's `readEntries` fails with
        // an EncodingError on a page opened from a `file://` URL, and a built page is often opened that way.
        const walkHandle = async (h, path) => {
          if (h.kind === "file") {
            try { send(await h.getFile(), path); } catch (e) { failed(path, e); }
            return;
          }
          try { for await (const kid of h.values()) await walkHandle(kid, path + "/" + kid.name); }
          catch (e) { failed(path, e); }
        };
        // **Only a folder is walked.** A dropped file is read as the file it is: through an entry, some
        // browsers cannot read even a lone file on a page opened from a `file://` URL. Entries and handles
        // are taken during the event, because a drop's items are unreadable once it returns; a handle the
        // browser then refuses — as it may in a sandboxed frame — falls back to the entry. A browser with
        // no entries at all cannot tell a folder from a file, and is given `files` as it always was.
        const dropped = (dt) => {
          const items = [...(dt?.items ?? [])].filter((it) => it.kind === "file");
          const files = [...(dt?.files ?? [])];
          const entries = items.map((it) => it.webkitGetAsEntry?.() ?? null);
          if (items.length === 0 || files.length !== items.length || entries.some((x) => x === null)) {
            take(dt?.files);
            return;
          }
          const handles = items.map((it, i) =>
            entries[i].isDirectory && it.getAsFileSystemHandle ? it.getAsFileSystemHandle() : null);
          items.forEach((it, i) => {
            if (!entries[i].isDirectory) take([files[i]]);
            else if (handles[i]) handles[i].then((h) => h ? walkHandle(h, h.name) : walk(entries[i]), () => walk(entries[i]));
            else walk(entries[i]);
          });
        };
        const changed = (ev) => { const t = origin(ev); if (t?.files) take(t.files); };
        root.addEventListener("change", changed);
        // A link to `#/somewhere`, and the browser's back and forward, move the location; the program follows.
        addEventListener("hashchange", () => emit(["where", location.hash]));
        // Without preventing dragover a dropped file replaces the page.
        document.addEventListener("dragover", (ev) => ev.preventDefault());
        document.addEventListener("drop", (ev) => { ev.preventDefault(); dropped(ev.dataTransfer); });
        const apply = (m) => ops[m[0]](...m.slice(1));
        return (m) => { if (m[0] === "ops") { for (const x of m[1]) apply(x); } else apply(m); };
      };
      """;
}

/**
 * **The page's thread starts every program** (design/system/0015 decision 3), for every worker that asks: the
 * page's own program, a copy of the page it started, a module, and anything those start in turn. It makes a
 * `MessageChannel` and hands one end to the worker that asked and the other to the new one, so the two talk
 * directly; the page's thread hears from them only to start a child and to stop one.
 *
 * **Why the page's thread**: a page opened from a file has an opaque origin, and a worker there may not start a
 * worker — while the page's own thread may. One route for `http://` and `file://` alike, so the tests over `http://`
 * exercise what a page from a file depends on. And only the thread that started a worker can end it, which is
 * what `^C` needs: asked to stop a child, it stops it and everything it started, as ending a worker that had
 * started its own used to.
 *
 * `broker(from, message)` answers whether the message was the broker's: `["broker", n, "start", kind, init]`, answered
 * `["brokered", n, id, port]` (or `null` and why), or `["broker", 0, "stop", id]`. A child that dies without exiting —
 * a trap the browser reports — is told to its parent as `["childFailed", id, why]`.
 */
export string brokerSide() {
  return """
      const wacBroker = (script) => {
        const kids = new Map();
        let next = 0;
        const stop = (id) => {
          const k = kids.get(id);
          if (k === undefined) return;
          kids.delete(id);
          k.worker.terminate();
          for (const [other, o] of kids) if (o.parent === k.worker) stop(other);
        };
        const broker = (from, m) => {
          if (!Array.isArray(m) || m[0] !== "broker") return false;
          const [, n, op, ...rest] = m;
          if (op === "stop") { stop(rest[0]); return true; }
          const [kind, init] = rest;
          let worker;
          try { worker = new Worker(script); }
          catch (e) { from.postMessage(["brokered", n, -1, null, String(e?.message ?? e)]); return true; }
          const id = ++next;
          kids.set(id, { worker, parent: from });
          worker.onmessage = (e) => { broker(worker, e.data); };
          worker.onerror = (e) => {
            e.preventDefault();
            if (kids.has(id)) from.postMessage(["childFailed", id, e.message || "the program stopped"]);
          };
          const channel = new MessageChannel();
          worker.postMessage([kind, init, channel.port2], [channel.port2, ...(init.wasm ? [init.wasm.buffer] : [])]);
          from.postMessage(["brokered", n, id, channel.port1], [channel.port1]);
          return true;
        };
        return broker;
      };
      """;
}

/**
 * A worker's side of `brokerSide`: `wacAskPage` asks the page's thread to start a child and answers its id and this
 * worker's end of the channel; `wacTellPage` asks it to stop one; `wacFromPage` takes the answers, and says whether a
 * message was one. `wacFromParent` is what a child's parent sends down the channel.
 */
export string brokerClient() {
  return """
      const wacAsked = new Map();
      let wacAskedNext = 0;
      const wacChildFailed = new Map();
      const wacAskPage = (m, transfer) => new Promise((done) => {
        const n = ++wacAskedNext;
        wacAsked.set(n, done);
        postMessage(["broker", n, ...m], transfer ?? []);
      });
      const wacTellPage = (m) => postMessage(["broker", 0, ...m]);
      const wacFromPage = (m) => {
        if (!Array.isArray(m)) return false;
        if (m[0] === "brokered") {
          const done = wacAsked.get(m[1]);
          wacAsked.delete(m[1]);
          if (done) done([m[2], m[3], m[4] ?? ""]);
          return true;
        }
        if (m[0] === "childFailed") { wacChildFailed.get(m[1])?.(m[2]); return true; }
        return false;
      };
      const wacFromParent = (m, stdin, fsIn) => {
        if (m[0] === "stdin") stdin.push(m[1]);
        else if (m[0] === "stdinEnd") stdin.end();
        else if (m[0] === "fs") fsIn.push(m[1]);
      };
      """;
}

/**
 * The page, with the program in a worker: the program's half in a script the browser does not run, the module as
 * base64 in an element it does not run either, and the document's half starting a worker from that script's text
 * and handing it the module. A blob rather than a second file, so the page stays one file that also works from a
 * `file://` URL — and a **classic** worker: a module worker made from a blob is refused on a `file://` page, and a
 * `data:` one would lose the page's origin and the storage that goes with it.
 */
export string workerIndexFor(string title, string wasm, i32 grants) {
  return head(title) + moduleElement(wasm)
       + "<script type=\"text/plain\" id=\"wac-program\">\n" + systemSide() + programSide() + moduleSide()
       // The first message says who this worker is: the page's program, or a module a program started.
       + brokerClient()
       + "let receive = null;\n"
       + "onmessage = (e) => {\n"
       + "  if (wacFromPage(e.data)) return;\n"
       + "  if (receive !== null) return receive(e.data);\n"
       + "  if (e.data[0] === \"module\") { receive = () => {}; return wacModule(e.data[1], e.data[2]); }\n"
       + "  receive = wacPage(e.data[2], \{grants}, (m, transfer) => postMessage(m, transfer ?? []), e.data[1], e.data[3]);\n"
       + "};\n</script>\n"
       + documentScript(documentSide() + brokerSide() + moduleBytes()
       + """
         const source = document.getElementById("wac-program").textContent;
         const script = URL.createObjectURL(new Blob([source], { type: "text/javascript" }));
         const worker = new Worker(script);
         const broker = wacBroker(script);
         const apply = wacDocument(document.getElementById("app"), (m, transfer) => worker.postMessage(m, transfer ?? []));
         worker.onmessage = (e) => { if (!broker(worker, e.data)) apply(e.data); };
         worker.onerror = (e) => console.error(e.message);
         const wasm = wacModuleBytes();
         worker.postMessage(["page", location.hash, wasm, location.protocol === "file:" ? null : location.href], [wasm.buffer]);
         """)
       + "</body>\n</html>\n";
}

/** The page, with the program on the page's own thread: the two halves joined directly. */
export string inPageIndexFor(string title, string wasm, i32 grants) {
  return head(title) + moduleElement(wasm)
       + documentScript(systemSide() + moduleSide() + programSide() + documentSide() + moduleBytes()
       + "let receive = null;\n"
       + "const apply = wacDocument(document.getElementById(\"app\"), (m) => receive(m));\n"
       + "receive = wacPage(wacModuleBytes(), \{grants}, (m) => apply(m), location.hash, location.protocol === \"file:\" ? null : location.href);\n")
       + "</body>\n</html>\n";
}

/** The page's module, as base64 in an element the browser does not run. */
string moduleElement(string wasm) {
  return "<script type=\"text/plain\" id=\"wac-module\">" + wasm + "</script>\n";
}

/** `wacModuleBytes()`: the module that element holds, as bytes. */
string moduleBytes() {
  return """
      const wacModuleBytes = () => {
        const text = atob(document.getElementById("wac-module").textContent.trim());
        const bytes = new Uint8Array(text.length);
        for (let i = 0; i < text.length; i++) bytes[i] = text.charCodeAt(i);
        return bytes;
      };
      """;
}

/**
 * The document's script, held as text, and the one script the page runs as written: `loaderScript`,
 * which runs it from a `blob:` URL.
 *
 * **So that the Content Security Policy can name what runs** (`design/system/0012`, "Policy is in wac;
 * the browser enforces it again"). A policy allows inline script by hash, and the document's script
 * holds the program in the in-page build — a different hash for every program, and a SHA-256 this
 * program would have to carry a copy of. The loader is the same few lines for every page, so its hash
 * is a constant (`loaderHash`, checked by `tools/wac/webpolicy_test.wac`), and the policy allows that
 * and `blob:`, which only a script already running can make.
 */
string documentScript(string body) {
  return "<script type=\"text/plain\" id=\"wac-document\">\n\"use strict\";\n" + body + "</script>\n"
       + "<script>" + loaderScript() + "</script>\n";
}

/** The script that runs `#wac-document`. Change it and `loaderHash` changes with it. */
export string loaderScript() {
  return "const s = document.createElement(\"script\"); "
       + "s.src = URL.createObjectURL(new Blob([document.getElementById(\"wac-document\").textContent], { type: \"text/javascript\" })); "
       + "document.body.appendChild(s);";
}

/** `loaderScript`'s SHA-256, base64 — what the policy allows it by. */
export string loaderHash() { return "xLE7i4agIkrLt+lCU03oQkaXG/ugC3kfxyQdZETBPVM="; }

/**
 * The page's Content Security Policy: its loader, scripts it made itself, its own wasm, and nothing
 * fetched from anywhere — not an image, not a style sheet, not a frame. A program has no network grant,
 * so a document it draws cannot be one either: `<img src="https://elsewhere/?secret">` is refused here
 * as well as by the handle layer's policy, and an injected `<script>` or `onerror` does not run.
 *
 * **Except its own origin, to read** (`connect-src 'self'`): `wac.site`'s GETs, which the host makes for a program
 * and keeps under the page's folder. A program runs no script of its own, so the host is all that can.
 */
export string policy() {
  return "default-src 'none'; connect-src 'self'; script-src 'sha256-" + loaderHash() + "' blob: 'wasm-unsafe-eval'; "
       + "worker-src blob:; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; "
       + "media-src data: blob:; base-uri 'none'; form-action 'none'";
}

/** Everything before the script: the document the program draws into. */
string head(string title) {
  return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
       + "<meta http-equiv=\"Content-Security-Policy\" content=\"" + policy() + "\">\n"
       + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
       + "<title>" + title + "</title>\n</head>\n<body>\n<div id=\"app\"></div>\n";
}

export i32 buildPage(string[] argv, Output err, Output out, Files fs, Procs procs) {
  Asked a = askedOf(argv);
  if (a.entry == "" || a.out == "") {
    err.write("usage: build.wac <entry.wac> <out-dir> [--in-page] [--dev] [--grant read,write] [--spawn <export>] [--title <t>] [--wac <binary>] [--page <spec>]\n".toBytes());
    return 2;
  }
  // **The page's module is a module of this project**, so it is written inside it: from anywhere else its
  // imports would cross a project boundary, and the build would fail naming an import rather than this.
  if (leavesHere(a.out)) {
    err.write("build.wac: \{a.out}: the output directory must be inside this directory, since the page's module is written there and imports the program\n".toBytes());
    return 2;
  }
  fs.mkdir(a.out, true).wait();
  string source = a.out + "/page.wac";
  // A path names the file from here, and the module sits in `out`; anything else is a mapped name.
  bool pagePath = a.pageSpec.len() > 0 && (a.pageSpec.slice(0, 1) == "." || a.pageSpec.slice(0, 1) == "/");
  string pageSpec = pagePath ? relativeTo(a.out, a.pageSpec) : a.pageSpec;
  string entrySpec = relativeTo(a.out, a.entry);
  fs.writeFile(source, moduleFor(entrySpec, pageSpec, a.spawn, a.dev).toBytes()).wait();
  auto builtRan = flatten(procs.exec(a.wac, ["build", source, "-o", a.out + "/page"], u8[](), ChildEnv.inherited(), Launch.plain()).wait());
  Exec? built = builtRan.ok();
  if (built is null || !built!.ok()) {
    if (built is not null) {
      err.write(built!.stderr);
      err.write(built!.stdout);
    }
    if (builtRan.isErr()) { flatten(err.write("build.wac: \{a.wac}: \{builtRan.err()!}\n".toBytes()).wait()).isOk(); }
    return 1;
  }
  string wasmPath = a.out + "/page.wasm";
  auto wasmRead = flatten(fs.readFile(wasmPath).wait());
  u8[]? wasm = wasmRead.ok();
  if ((wasm is null)) {
    err.write("build.wac: \{wasmPath}: \{wasmRead.isErr() ? "\{wasmRead.err()!}" : ""}\n".toBytes());
    return 1;
  }
  string index = a.out + "/index.html";
  string encoded = base64(wasm!);
  string page = a.inPage ? inPageIndexFor(a.title, encoded, a.grants) : workerIndexFor(a.title, encoded, a.grants);
  fs.writeFile(index, page.toBytes()).wait();
  out.line("\{index}: \{wasm!.len()} bytes of module");
  return 0;
}

export i32 main(Sys sys) { return buildPage(sys.args(), sys.stderr(), sys.stdout(), sys.files(), sys.procs()); }
