// What a page can tell about the person and the screen: its own size on screen, which way the wheel turned, how
// long a key took to reach it, where in the browser's history it is — which it can add to and Back returns from — and
// two fingers at once on a pad that keeps each until it lifts; and a canvas it draws in its own worker. What `test/sense_live.test.ts` builds and drives in a browser.

import { Element, ElementEvent, Listen, Page } from "../src/page.wac";

/** A whole number as the host writes one: digits, perhaps after a `-`. */
i32 whole(string s) {
  u8[] b = s.toBytes();
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) { if (b[i] >= '0' && b[i] <= '9') { v = v * 10 + ((b[i] - '0') as i32); } }
  return b.len() > 0 && b[0] == '-' ? 0 - v : v;
}

export async i32 main(Page page) {
  Element box = page.root().append("div");
  box.attr("id", "box");
  // Focusable, so the keys come to it once it is clicked.
  box.attr("tabindex", "0");
  Element size = box.append("p");
  size.attr("id", "size");
  Element wheel = box.append("p");
  wheel.attr("id", "wheel");
  wheel.text("0");
  Element key = box.append("p");
  key.attr("id", "key");
  Element where = box.append("p");
  where.attr("id", "where");
  where.text(page.location());
  page.onLocation((string w) => { where.text(w == "" ? "home" : w); });
  Element deeper = box.append("button");
  deeper.attr("id", "deeper");
  deeper.text("Deeper");
  deeper.on("click", Listen.none(), (ElementEvent e) => { page.go("deeper", true); });
  // Each finger by its pointer: pressed, and lifted — heard here even when it lifts somewhere else (`capture`).
  Element pad = box.append("div");
  pad.attr("id", "pad");
  pad.attr("style", "width: 240px; height: 120px; background: #dde; touch-action: none");
  Element fingers = box.append("p");
  fingers.attr("id", "fingers");
  string felt = "";
  pad.on("pointerdown", Listen.keys("* capture"), (ElementEvent e) => { felt = felt + "down \{e.pointer};"; fingers.text(felt); });
  pad.on("pointerup", Listen.keys("* capture"), (ElementEvent e) => { felt = felt + "up \{e.pointer};"; fingers.text(felt); });
  // A canvas drawn red: by this program's worker itself, once the document has handed it over.
  Element drawn = box.append("canvas");
  drawn.attr("id", "drawn");
  u8[] red = u8[].filled(4 * 2 * 4, 255 as u8);
  for (i32 i = 0; i < 8; i++) {
    red[i * 4 + 1] = 0 as u8;
    red[i * 4 + 2] = 0 as u8;
  }
  drawn.pixels(4, 2, red);
  i32 turned = 0;
  box.on("resize", Listen.none(), (ElementEvent e) => { size.text("\{e.x}x\{e.y}"); });
  box.on("wheel", Listen.all(), (ElementEvent e) => {
    turned = turned + whole(e.value);
    wheel.text("\{turned}");
  });
  box.on("keydown", Listen.none(), (ElementEvent e) => {
    f64 late = page.now() - e.at;
    key.text(e.value + (late >= 0.0 && late < 1000.0 ? " on time" : " late by \{late}"));
  });
  return 0;
}
